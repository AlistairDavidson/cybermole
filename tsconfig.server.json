{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist-server",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "server/**/*.ts",
    "cli/**/*.ts",
    "src/lib/**/*.ts",
    "src/schemas/**/*.ts",
    "packages/app-kit/src/**/*.ts"
  ],
  "exclude": ["packages/app-kit/src/island.ts"]
  // ^ client-only (preact's jsx types reference lib="dom", which would
  // pollute this node-typed program — FormData/RequestInit clashes). The
  // kit's own tsconfig.json checks it, with DOM libs.
}
