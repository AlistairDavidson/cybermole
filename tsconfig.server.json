{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist-server",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "server/**/*.ts",
    "cli/**/*.ts",
    "src/lib/**/*.ts",
    "src/schemas/**/*.ts",
    "packages/app-kit/src/**/*.ts"
  ],
  "exclude": ["packages/app-kit/src/element.ts", "packages/app-kit/src/agent-console.ts"]
  // ^ client-only modules (the DOM and xterm libraries pollute this
  // node-typed program). The kit's own tsconfig.json checks them, with DOM
  // libs. live.ts stays in: @types/node declares WebSocket, so the doorbell
  // compiles for its unit tests.
}
