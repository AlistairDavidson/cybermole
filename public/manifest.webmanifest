{
  "name": "web-pi",
  "short_name": "web-pi",
  "description": "pi coding-agent sessions in a browser terminal, backed by tmux",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#11131a",
  "theme_color": "#11131a",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
