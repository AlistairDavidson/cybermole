{
  "name": "cybermole",
  "version": "0.1.0",
  "description": "pi coding-agent sessions in the browser",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose --profile dev up --build dev",
    "dev:set-password": "docker compose --profile dev exec dev npm run set-password",
    "dev:server": "node tools/dev-server-watch.mjs",
    "build": "astro build && tsc -p tsconfig.server.json && node tools/place-kit-manifest.mjs",
    "start": "docker compose up -d --build",
    "set-password": "node dist-server/server/set-password.js",
    "check": "astro check && tsc -p tsconfig.server.json --noEmit && tsc -p packages/app-kit/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:unit": "tsc -p tsconfig.server.json && node tools/place-kit-manifest.mjs && node --test tests/unit/*.test.mjs",
    "prepack": "npm run build && node tools/prepack.mjs"
  },
  "bin": {
    "cybermole": "dist-server/server/main.js",
    "cybermole-set-password": "dist-server/server/set-password.js",
    "cybermole-cli": "dist-server/cli/main.js"
  },
  "files": [
    "dist/",
    "dist-server/",
    "runtime/",
    "runtime/reference-apps/notes/.pi/mcp.json"
  ],
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@awesome.me/astro-lit": "^5.0.4",
    "@awesome.me/webawesome": "^3.14.0",
    "@earendil-works/pi-coding-agent": "^1.0.1",
    "@fastify/busboy": "^3.2.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "astro": "^7.0.0",
    "cron-parser": "^5.10.1",
    "kysely": "^0.29.6",
    "node-pty": "^1.0.0",
    "@preact/signals-core": "^1.14.5",
    "validation-enhancer": "^1.0.6",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.7",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.59.1",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.2"
  }
}
