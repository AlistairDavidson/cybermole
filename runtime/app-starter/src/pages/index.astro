---
// The home page: the card (the page's one page-level wa-* half) hosting
// the ping action's component, inside the kit's AppShell (the document, the
// stylesheet and the cybermole header — every app page renders in it). The
// components own their wa-* halves, and the client script imports
// enhancers, nothing else wa-*. add_action appends inside the three marker pairs below.
import AppShell from '@cybermole/app-kit/AppShell.astro';
import '@awesome.me/webawesome/dist/components/card/card.js';
// BEGIN ACTION IMPORTS (generated — add_action appends one import per action)
import Ping from '../components/Ping/Ping.astro';
// END ACTION IMPORTS
const builtAt = new Date().toISOString();
---
<AppShell title="__APP_NAME__">
    <main>
      <wa-card>
        <h1 slot="header">__APP_NAME__</h1>
        <p>__APP_DESCRIPTION__</p>
        <!-- The action components: each a directory owning its SSR (.astro)
             and its enhancer (.ts) — enhance, never render (CODE_STYLE.md §7).
             add_action appends one component usage per action inside the
             markers below. -->
        <!-- BEGIN ACTION MOUNTS (generated — add_action appends one element section per action) -->
        <Ping />
        <!-- END ACTION MOUNTS -->
        <p class="wa-caption">built at {builtAt}</p>
      </wa-card>
    </main>
    <style>
      /* The page column — the one shape the utility set has no class for;
       * tokens only, defined once (the design skill's content-column rule). */
      main {
        max-inline-size: calc(var(--wa-space-4xl) * 10);
        margin-block: var(--wa-space-3xl);
        margin-inline: auto;
        padding-inline: var(--wa-space-m);
      }
    </style>
    <!-- The agent drawer: one terminal in this app's operator workspace
         (created on first open), plus the builder deep link. The slug is
         substituted at scaffold time. -->
    <agent-console slug="__APP_SLUG__"></agent-console>
    <script>
      // The shell's client half first (the wa-* prelude, the header).
      import '@cybermole/app-kit/app-shell';
      // The page's own wa-* halves (the card); the components import theirs.
      import '@awesome.me/webawesome/dist/components/card/card.js';
      // The agent drawer (client-only; it imports its own wa-* halves).
      import '@cybermole/app-kit/agent-console';

      // add_action appends one enhancer import per action inside these markers.
      // BEGIN ACTION ENHANCERS (generated — add_action appends one import per action)
      import '../components/Ping/ping';
      // END ACTION ENHANCERS
    </script>
</AppShell>
