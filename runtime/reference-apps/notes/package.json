{
  "name": "notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "a cybermole app on @cybermole/app-kit — scaffolded from the image's app-starter template",
  "scripts": {
    "setup": "node scripts/setup-node-modules.mjs",
    "lint:arch": "node node_modules/@cybermole/app-kit/scripts/arch-check.mjs src",
    "typecheck": "astro check && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "astro build && node scripts/check-selfcontained.mjs dist/server/entry.mjs",
    "check": "npm run lint:arch && npm run typecheck && npm run test && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.6",
    "@awesome.me/astro-lit": "^5.0.4",
    "@awesome.me/webawesome": "^3.14.0",
    "@cybermole/app-kit": "*",
    "@lit-labs/ssr-dom-shim": "^1.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@preact/signals-core": "^1.14.5",
    "@types/node": "^26.0.0",
    "astro": "^7.0.0",
    "kysely": "^0.29.6",
    "lit": "^3.3.3",
    "lit-element": "^4.2.1",
    "parse5": "^7.3.0",
    "ws": "^8.18.0",
    "typescript": "^5.8.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "playwright": "^1.59.1"
  }
}
