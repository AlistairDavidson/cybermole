---
// The note page: note_get rendered server-side, the editor component. A
// missing note answers 404. The page owns its page-level wa-* halves (the
// card, the header's badges); the editor directory owns its own.
import '@awesome.me/webawesome/dist/components/card/card.js';
import '@awesome.me/webawesome/dist/components/badge/badge.js';
import { getAppDb } from '../../lib/notes-db';
import { noteGetResult } from '../../lib/note_get';
import NotesEditor from '../../components/NotesEditor/NotesEditor.astro';
import type { Note } from '../../lib/notes-core';

const id = Number(Astro.params.id);
const got = Number.isInteger(id) && id > 0 ? noteGetResult(getAppDb(), id) : null;
const note: Note | null = got !== null && got.ok ? got.data.note : null;
if (note === null) Astro.response.status = 404;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{note !== null ? `${note.title} — Notes` : 'note not found — Notes'}</title>
    <link rel="icon" type="image/svg+xml" href="/apps/notes/favicon.svg" />
  </head>
  <body>
    <main style="font-family: system-ui; max-width: 40rem; margin: 3rem auto; padding: 0 1rem;">
      <wa-card>
        <h1 slot="header">{note !== null ? note.title : 'note not found'}</h1>
        {note === null ? (
          <p>
            no note by that id — <a href={`${base}/`}>back to the list</a>.
          </p>
        ) : (
          <>
            <p style="margin: 0.1rem 0;">
              {note.archived && <wa-badge>archived</wa-badge>}
              {note.tags.map(t => (
                <wa-badge>{t}</wa-badge>
              ))}
            </p>
            {/* The note's values ride in the editor's SSR'd controls
                 (data-note-id names the note); the enhancer reads them
                 from there. Without JS the note still reads. */}
            <NotesEditor mode="edit" note={note} />
            <p>
              <a href={`${base}/`}>back to the list</a>
            </p>
          </>
        )}
      </wa-card>
    </main>
    <!-- The agent drawer (see the app-starter README): one terminal in
         this app's operator workspace, plus the builder deep link. -->
    <agent-console slug="notes"></agent-console>
    <script>
      // The page's own wa-* halves (the card and the header badges); the
      // editor component imports its own.
      import '@cybermole/app-kit/wa-client';
      import '@awesome.me/webawesome/dist/components/card/card.js';
      import '@awesome.me/webawesome/dist/components/badge/badge.js';
      // The agent drawer (client-only; it imports its own wa-* halves).
      import '@cybermole/app-kit/agent-console';
      import '../../components/NotesEditor/notes-editor';
    </script>
  </body>
</html>
