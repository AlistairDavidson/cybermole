---
// The list page: note_list rendered server-side, the capture editor, and
// the ping action — each a component directory that owns its SSR and its
// enhancer. The find form uses native controls so it works without JS.
// The page owns its page-level wa-* halves (card, callout) and its stylesheet
// (webawesome.css: tokens, utilities, native styles); the components own
// theirs. add_action appends inside the three marker pairs below.
import '@awesome.me/webawesome/dist/styles/webawesome.css';
import '@awesome.me/webawesome/dist/components/card/card.js';
import '@awesome.me/webawesome/dist/components/callout/callout.js';
import { getAppDb } from '../lib/notes-db';
import { noteListResult } from '../lib/note_list';
import NotesList from '../components/NotesList/NotesList.astro';
// BEGIN ACTION IMPORTS (generated — add_action appends one import per action)
import NotesEditor from '../components/NotesEditor/NotesEditor.astro';
import NotesPing from '../components/NotesPing/NotesPing.astro';
// END ACTION IMPORTS

const sp = Astro.url.searchParams;
const search = sp.get('search') ?? '';
const tag = sp.get('tag') ?? '';
const archivedView = sp.get('archived') === 'true';
const listed = noteListResult(getAppDb(), {
  search: sp.get('search') ?? undefined,
  tag: sp.get('tag') ?? undefined,
  archived: sp.get('archived') ?? undefined,
});
const notes = listed.ok ? listed.data.notes : [];
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Notes</title>
    <link rel="icon" type="image/svg+xml" href="/apps/notes/favicon.svg" />
  </head>
  <body>
    <main>
      <wa-card>
        <h1 slot="header">Notes</h1>
        <p>capture, find, and archive notes and standup journals</p>

        <!-- Native, not wa-input: a wa-input's value never submits without JS. -->
        <form method="get" class="find wa-cluster wa-gap-s">
          <input type="search" name="search" placeholder="search" value={search} aria-label="search" />
          <input type="text" name="tag" placeholder="tag" value={tag} aria-label="tag" />
          {archivedView && <input type="hidden" name="archived" value="true" />}
          <button type="submit">find</button>
          <a href={archivedView ? `${base}/` : `${base}/?archived=true`}>
            {archivedView ? 'live notes' : 'archived'}
          </a>
        </form>
        {!listed.ok && (
          <wa-callout variant="danger" role="alert">
            {listed.errorMessage}
          </wa-callout>
        )}

        <h2>{archivedView ? 'archived notes' : 'notes'}</h2>
        {notes.length === 0 && (
          <p>{archivedView ? 'nothing archived yet.' : 'no notes yet — capture one below.'}</p>
        )}
        <NotesList notes={notes} />

        <!-- BEGIN ACTION MOUNTS (generated — add_action appends one element section per action) -->
        {!archivedView && <NotesEditor mode="create" />}
        <NotesPing />
        <!-- END ACTION MOUNTS -->
      </wa-card>
    </main>
    <style>
      /* The page column — the one shape the utility set has no class for;
       * tokens only, defined once (the design skill's content-column rule). */
      main {
        max-inline-size: calc(var(--wa-space-4xl) * 10);
        margin-block: var(--wa-space-3xl);
        margin-inline: auto;
        padding-inline: var(--wa-space-m);
      }
    </style>
    <!-- The agent drawer (see the app-starter README): one terminal in
         this app's operator workspace, plus the builder deep link. -->
    <agent-console slug="notes"></agent-console>
    <script>
      // The page's own wa-* halves (card, callout); the components import theirs.
      import '@cybermole/app-kit/wa-client';
      import '@awesome.me/webawesome/dist/components/card/card.js';
      import '@awesome.me/webawesome/dist/components/callout/callout.js';
      // The agent drawer (client-only; it imports its own wa-* halves).
      import '@cybermole/app-kit/agent-console';

      // The live list (the app's WS example): its enhancer dials
      // /apps/notes/ws (the kit's socket client owns the capped backoff)
      // and refreshes through the typed note_list client on
      // notes_changed — WS carries the nudge, HTTP carries the data.
      import '../components/NotesList/notes-list';

      // add_action appends one import per action inside these markers.
      // BEGIN ACTION ENHANCERS (generated — add_action appends one import per action)
      import '../components/NotesEditor/notes-editor';
      import '../components/NotesPing/notes-ping';
      // END ACTION ENHANCERS
    </script>
  </body>
</html>
