---
import Base from "../layouts/Base.astro";
import "@awesome.me/webawesome/dist/components/card/card.js";
import "@awesome.me/webawesome/dist/components/button/button.js";
---

<Base title="cybermole — offline">
  <main class="offline-main wa-stack">
    <wa-card class="offline-card">
      <h1>
        <!-- the cybermole glyph (public/cybermole.svg), inline so the shell
             needs no fetches. currentColor + the surface token keep it readable
             in both modes: the mole inverts like the icon's dark variant. -->
        <svg class="offline-glyph" viewBox="0 0 512 512" aria-hidden="true">
          <ellipse cx="256.4" cy="557.9" rx="192" ry="448" fill="currentColor"></ellipse>
          <rect
            x="162.6"
            y="217.2"
            width="188.2"
            height="3.8"
            fill="none"
            stroke="var(--wa-color-surface-default, #ffffff)"
            stroke-width="28"></rect>
          <circle
            cx="256.4"
            cy="327.1"
            r="64"
            fill="var(--wa-color-surface-default, #ffffff)"
            stroke="currentColor"
            stroke-width="20"></circle>
          <circle cx="256.4" cy="357.8" r="20" fill="currentColor"></circle>
          <ellipse
            cx="73.4"
            cy="515.7"
            rx="64"
            ry="92"
            fill="var(--wa-color-surface-default, #ffffff)"
            stroke="currentColor"
            stroke-width="20"></ellipse>
          <ellipse
            cx="439.4"
            cy="515.7"
            rx="64"
            ry="92"
            fill="var(--wa-color-surface-default, #ffffff)"
            stroke="currentColor"
            stroke-width="20"></ellipse>
        </svg>
        offline
      </h1>
      <p>
        cybermole needs a connection — the terminal runs over a live WebSocket.
      </p>
      <wa-button variant="brand" onclick="location.reload()">
        reconnect
      </wa-button>
    </wa-card>
  </main>
</Base>

<script>
  import "@awesome.me/astro-lit/dsd-polyfill.js";
  import "@awesome.me/astro-lit/hydration-support.js";
  import "../icons";
  import "@awesome.me/webawesome/dist/components/card/card.js";
  import "@awesome.me/webawesome/dist/components/button/button.js";
</script>
