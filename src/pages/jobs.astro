---
import Base from '../layouts/Base.astro';
import JobsApp from '../components/JobsApp/JobsApp.astro';
import { assertCybermoleLocals } from '../lib/web/locals';
// A failed listing renders the empty state's message; the poll keeps trying.
const { cybermole } = assertCybermoleLocals(Astro.locals);
const listed = await cybermole.scheduler.listJobs();
const jobs = listed.ok ? listed.data.jobs : null;
// A failed app read just leaves the tag picker empty until a refresh.
const appsListed = cybermole.apps.listApps();
const apps = appsListed.ok ? appsListed.data.apps : [];
// console.error: winston stays out of the Vite bundle.
if (!listed.ok) console.error(`jobs page: ${listed.errorMessage}`);
if (!appsListed.ok) console.error(`jobs page: ${appsListed.errorMessage}`);
---
<Base title="cybermole — jobs" header="jobs">
  <JobsApp jobs={jobs} apps={apps} />
</Base>
