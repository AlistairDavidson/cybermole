---
// GET /partials/jobs-list — the /jobs list as a fragment: <jobs-app>
// swaps it in on its 15 s refresh and after save / run / delete. Behind
// the main.ts gate (signed out: 401) and src/middleware.ts (no locals:
// 503). A failed listing answers 500 with no fragment — the element keeps
// what it shows. The app options ride along in the fragment's root (the
// tag picker re-reads them on open), so a refresh renews both.
import JobsList from '../../components/JobsApp/JobsList.astro';
import { assertCybermoleLocals } from '../../lib/web/locals';

export const partial = true;

const { cybermole } = assertCybermoleLocals(Astro.locals);
const listed = await cybermole.scheduler.listJobs();
const appsListed = cybermole.apps.listApps();
Astro.response.headers.set('Cache-Control', 'no-store');
if (!listed.ok || !appsListed.ok) {
  // console.error on purpose, not src/lib/platform/logger.ts: frontmatter is
  // Astro-bundled, and winston stays out of the Vite bundle (CODE_STYLE §6).
  if (!listed.ok) console.error(`jobs list partial: ${listed.errorMessage}`);
  if (!appsListed.ok) console.error(`jobs list partial: ${appsListed.errorMessage}`);
  Astro.response.status = 500;
}
---
{listed.ok && appsListed.ok && <JobsList jobs={listed.data.jobs} apps={appsListed.data.apps} />}
