---
// The /settings dashboard as a fragment. A failed read answers 500 with no
// fragment, so the element keeps what it shows.
import SettingsView from '../../components/Settings/SettingsView.astro';
import { assertCybermoleLocals } from '../../lib/web/locals';

export const partial = true;

const { cybermole } = assertCybermoleLocals(Astro.locals);
const settings = cybermole.settingsState();
Astro.response.headers.set('Cache-Control', 'no-store');
if (!settings.ok) {
  // console.error: winston stays out of the Vite bundle.
  console.error(`settings partial: ${settings.errorMessage}`);
  Astro.response.status = 500;
}
---
{settings.ok && <SettingsView state={settings.data} />}
