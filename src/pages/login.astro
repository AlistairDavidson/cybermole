---
import Base from '../layouts/Base.astro';
// These only SSR; the client script re-imports them so they upgrade
// (AGENTS.md). Never write a literal script open-tag in a frontmatter
// comment: vite's dep-scan would parse half the file as JS.
import '@awesome.me/webawesome/dist/components/card/card.js';
import '@awesome.me/webawesome/dist/components/input/input.js';
import '@awesome.me/webawesome/dist/components/button/button.js';
import '@awesome.me/webawesome/dist/components/callout/callout.js';
import '@awesome.me/webawesome/dist/components/icon/icon.js';
import WaField from '../components/form/WaField.astro';
import { zodSchemaToHTMLAttributes } from '../lib/web/zod.service';
import { loginForm } from '../schemas/api';

// Native constraints from the same schema, so an empty field never spends a login attempt.
const validation = zodSchemaToHTMLAttributes(loginForm);
---
<Base title="cybermole — sign in">
  <main class="login-main wa-stack wa-align-items-center wa-justify-content-center">
    <wa-card class="login-card">
      <div class="wa-stack">
        <h1 class="wa-cluster wa-gap-2xs wa-heading-l"><wa-icon name="terminal"></wa-icon> cybermole</h1>
        <validation-enhancer-zod>
          <form id="login-form" class="wa-stack wa-gap-m">
            <WaField id="username" name="username" label="username" autocomplete="username" autofocus
              {...validation.username} />
            <WaField
              id="password"
              name="password"
              label="password"
              type="password"
              password-toggle
              autocomplete="current-password"
              {...validation.password}
            />
            <wa-button type="submit" variant="brand">sign in</wa-button>
            <wa-callout id="error" variant="danger" class="hidden"></wa-callout>
          </form>
        </validation-enhancer-zod>
      </div>
    </wa-card>
  </main>
</Base>

<script>
  // Must precede any wa-* import, or SSR'd elements render twice.
  import '@awesome.me/astro-lit/dsd-polyfill.js';
  import '@awesome.me/astro-lit/hydration-support.js';
  // Before any wa-* defines, or icons fetch from the CDN first.
  import '../icons';
  import '@awesome.me/webawesome/dist/components/card/card.js';
  import '@awesome.me/webawesome/dist/components/input/input.js';
  import '@awesome.me/webawesome/dist/components/button/button.js';
  import '@awesome.me/webawesome/dist/components/callout/callout.js';
  import '@awesome.me/webawesome/dist/components/icon/icon.js';

  import 'validation-enhancer/zod';
  import type { ValidationEnhancerZod } from 'validation-enhancer/zod';
  import { loginForm } from '../schemas/api';

  import { BASE } from '../base';
  // An empty wa-input's value is null, not ''.
  const value = (id: string): string =>
    (document.getElementById(id) as unknown as { value: string | null }).value ?? '';
  void customElements.whenDefined('validation-enhancer-zod').then(() =>
    (document.querySelector('validation-enhancer-zod') as ValidationEnhancerZod).setZodSchema(loginForm));
  // On <main>, above the enhancer: it stops invalid submits, and a listener
  // on the form would fire before validation.
  document.querySelector('.login-main')!.addEventListener('submit', async e => {
    e.preventDefault();
    const err = document.getElementById('error')!;
    err.classList.add('hidden');
    const res = await fetch(`${BASE}/login`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username: value('username'), password: value('password') }),
    });
    if (res.ok) {
      // This page renders in place of any signed-out URL; reload to land there.
      if (location.pathname === `${BASE}/login`) location.href = `${BASE}/`;
      else location.reload();
      return;
    }
    err.textContent =
      res.status === 429 ? 'too many attempts — wait 15 minutes' :
      res.status === 503 ? 'server busy — try again in a moment' :
      'invalid credentials';
    err.classList.remove('hidden');
  });
</script>
