---
import Base from '../layouts/Base.astro';
// Frontmatter imports SSR these components (astro-lit, declarative shadow
// DOM). They do NOT register client-side — the client script below
// re-imports them so the browser upgrades + hydrates them (form submission,
// value, password toggle all need the live elements).
// (A literal script open-tag must never appear in a frontmatter comment:
// vite's rolldown dep-scan strips only HTML comments from .astro sources,
// then parses every script block it finds as JS — a tag here once made it
// parse half the file as one broken module and killed `astro dev`.)
import '@awesome.me/webawesome/dist/components/card/card.js';
import '@awesome.me/webawesome/dist/components/input/input.js';
import '@awesome.me/webawesome/dist/components/button/button.js';
import '@awesome.me/webawesome/dist/components/callout/callout.js';
import '@awesome.me/webawesome/dist/components/icon/icon.js';
import WaField from '../components/form/WaField.astro';
import { zodSchemaToHTMLAttributes } from '../lib/web/zod.service';
import { loginForm } from '../schemas/api';

// Native constraints matching the schema the form validates with in the
// browser (validation-enhancer-zod, below) — an empty field never costs a
// POST (or a slot in the 10-per-15-min login budget).
const validation = zodSchemaToHTMLAttributes(loginForm);
---
<Base title="cybermole — sign in">
  <main class="login-main wa-stack">
    <wa-card class="login-card">
      <h1><wa-icon name="terminal"></wa-icon> cybermole</h1>
      <validation-enhancer-zod>
        <form id="login-form" class="wa-stack wa-gap-m">
          <WaField id="username" name="username" label="username" autocomplete="username" autofocus
            {...validation.username} />
          <WaField
            id="password"
            name="password"
            label="password"
            type="password"
            password-toggle
            autocomplete="current-password"
            {...validation.password}
          />
          <wa-button type="submit" variant="brand">sign in</wa-button>
          <wa-callout id="error" variant="danger" class="hidden"></wa-callout>
        </form>
      </validation-enhancer-zod>
    </wa-card>
  </main>
</Base>

<script>
  // Support modules MUST precede the wa-* imports — if the SSR'd elements
  // define before lit hydration support installs, they render twice
  // (@awesome.me/astro-lit README). Not script-position-dependent.
  import '@awesome.me/astro-lit/dsd-polyfill.js';
  import '@awesome.me/astro-lit/hydration-support.js';
  // Vendored glyph libraries must register before any wa-* component
  // module defines — else upgraded icons fetch from the CDN first.
  import '../icons';
  // Client-side: define the SSR'd wa-* components (upgrade + hydrate).
  import '@awesome.me/webawesome/dist/components/card/card.js';
  import '@awesome.me/webawesome/dist/components/input/input.js';
  import '@awesome.me/webawesome/dist/components/button/button.js';
  import '@awesome.me/webawesome/dist/components/callout/callout.js';
  import '@awesome.me/webawesome/dist/components/icon/icon.js';

  // Registers <validation-enhancer-zod> (and the base <validation-enhancer>).
  import 'validation-enhancer/zod';
  import type { ValidationEnhancerZod } from 'validation-enhancer/zod';
  import { loginForm } from '../schemas/api';

  import { BASE } from '../base';
  // An empty wa-input's value is null, not ''.
  const value = (id: string): string =>
    (document.getElementById(id) as unknown as { value: string | null }).value ?? '';
  void customElements.whenDefined('validation-enhancer-zod').then(() =>
    (document.querySelector('validation-enhancer-zod') as ValidationEnhancerZod).setZodSchema(loginForm));
  // Valid submits only: the enhancer stops an invalid one from propagating,
  // so this listener sits ABOVE it (on <main>) — a listener on the form
  // itself would fire before validation ran.
  document.querySelector('.login-main')!.addEventListener('submit', async e => {
    e.preventDefault();
    const err = document.getElementById('error')!;
    err.classList.add('hidden');
    const res = await fetch(`${BASE}/login`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username: value('username'), password: value('password') }),
    });
    if (res.ok) {
      // The server renders this page in place of any signed-out page URL
      // (/jobs, /?t=…): reload it to land where the user was going.
      if (location.pathname === `${BASE}/login`) location.href = `${BASE}/`;
      else location.reload();
      return;
    }
    err.textContent =
      res.status === 429 ? 'too many attempts — wait 15 minutes' :
      res.status === 503 ? 'server busy — try again in a moment' :
      'invalid credentials';
    err.classList.remove('hidden');
  });
</script>
