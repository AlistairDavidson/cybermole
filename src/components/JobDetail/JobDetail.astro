---
// /jobs/:name's shell. The log box and toast sit outside the swapped
// #job-detail fragment, so an open log survives a refresh. `job` null renders
// the not-found body.
import '@awesome.me/webawesome/dist/components/button/button.js';
import '@awesome.me/webawesome/dist/components/icon/icon.js';
import '@awesome.me/webawesome/dist/components/card/card.js';
import '@awesome.me/webawesome/dist/components/badge/badge.js';
import '@awesome.me/webawesome/dist/components/toast/toast.js';
import '@awesome.me/webawesome/dist/components/callout/callout.js';
import JobDetailBody from './JobDetailBody.astro';
import type { ScheduledJob } from '../../lib/platform/types';
import type { JobRunView } from '../../lib/jobs/jobs';

interface Props {
  /** null when the job doesn't exist */
  job: ScheduledJob | null;
  /** null when the read failed (the refresh retries) */
  runs: JobRunView[] | null;
}
const { job, runs } = Astro.props;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/+$/, '');
---
{job === null ? (
  <main class="jobs-main wa-stack wa-gap-m">
    <header class="jobs-header">
      <h1 class="wa-cluster wa-gap-2xs wa-heading-l"><wa-icon name="clock"></wa-icon> job not found</h1>
    </header>
    <wa-callout variant="warning">
      <wa-icon slot="icon" name="triangle-exclamation"></wa-icon>
      no job by this name — it may have been deleted.
    </wa-callout>
    <wa-button class="job-view" appearance="plain" size="s" href={`${base}/jobs`}>
      back to the jobs page
    </wa-button>
  </main>
) : (
  <job-detail>
    <main class="jobs-main wa-stack wa-gap-m">
      <JobDetailBody job={job} runs={runs} />
      <!-- Outside #job-detail, so a refresh doesn't wipe an open log. -->
      <div id="run-log-box" class="run-log-box hidden">
        <div class="run-log-head wa-split wa-caption-s">
          <span id="run-log-title"></span>
          <wa-button size="xs" appearance="plain" id="run-log-close">hide log</wa-button>
        </div>
        <pre id="run-log" class="run-log"></pre>
      </div>
    </main>
    <wa-toast placement="bottom-start"></wa-toast>
  </job-detail>
)}

<script>
  import "@awesome.me/astro-lit/dsd-polyfill.js";
  import "@awesome.me/astro-lit/hydration-support.js";
  import "../../icons";
  import "./job-detail-app";
</script>
