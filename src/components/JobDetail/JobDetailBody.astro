---
// JobDetailBody.astro — the /jobs/:name detail FRAGMENT: the definition
// card (name, schedule, command, app tag — with the edit entry) and the
// run history (exit codes + durations, the log buttons). Rendered by the
// page (src/pages/jobs/[name].astro) and by the partial
// (src/pages/partials/jobs/[name].astro) its 15 s poll and /ws/events
// subscription swap in — the same classes the runs dialog uses
// (console.css), so the two surfaces read alike. data-job carries the
// name across swaps (<job-detail> reads it — never its own state).
import '@awesome.me/webawesome/dist/components/button/button.js';
import '@awesome.me/webawesome/dist/components/icon/icon.js';
import '@awesome.me/webawesome/dist/components/card/card.js';
import '@awesome.me/webawesome/dist/components/badge/badge.js';
import { fmtDuration, fmtRunTime } from '../JobsApp/run-format';
import type { ScheduledJob } from '../../lib/platform/types';
import type { JobRunView } from '../../lib/jobs/jobs';

interface Props {
  job: ScheduledJob;
  /** null only for a failed history read (the refresh retries). */
  runs: JobRunView[] | null;
}
const { job, runs } = Astro.props;

// Matches the server's CYBERMOLE_BASE ('' for root, else '/foo').
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/+$/, '');
const last = job.last
  ? `${job.last}${job.lastResult === 'success' ? ' · ok' : job.lastResult === 'failed' ? ' · failed' : ''}`
  : 'never';
const editHref = `${base}/jobs?edit=${encodeURIComponent(job.name)}`;
---
<div id="job-detail" class="wa-stack wa-gap-m" data-job={job.name}>
  <header class="jobs-header wa-split">
    <h1>
      <wa-icon name="clock"></wa-icon>{job.name}
    </h1>
    <span class="wa-cluster wa-gap-3xs">
      {job.appName && <wa-badge pill class="job-app">{job.appName}</wa-badge>}
      {job.active
        ? <wa-badge pill variant="success">scheduled</wa-badge>
        : <wa-badge pill>invalid schedule</wa-badge>}
      {job.running && <wa-badge pill variant="brand">running</wa-badge>}
      {job.lastResult === 'failed' && <wa-badge pill variant="danger">last run failed</wa-badge>}
    </span>
  </header>

  <wa-card class="job">
    <dl class="job-meta">
      <dt>schedule</dt><dd><code>{job.schedule || '—'}</code></dd>
      <dt>command</dt><dd><code>{job.command || '—'}</code></dd>
      <dt>next</dt><dd>{job.next ?? '—'}</dd>
      <dt>last run</dt><dd>{last}</dd>
    </dl>
    <div class="job-actions wa-cluster wa-gap-2xs">
      {job.running && (
        <a class="job-view" href={`${base}/?run=${encodeURIComponent(job.session)}`}>
          view run<wa-icon name="play"></wa-icon>
        </a>
      )}
      <a class="job-view" href={editHref}>
        edit<wa-icon name="pencil"></wa-icon>
      </a>
      <a class="job-view" href={`${base}/jobs`}>
        all jobs<wa-icon name="clock"></wa-icon>
      </a>
    </div>
  </wa-card>

  <section class="wa-stack wa-gap-xs">
    <h2 class="runs-title">
      <wa-icon name="eye"></wa-icon> run history
    </h2>
    {runs === null
      ? <p class="runs-empty">the run history could not be read — the refresh keeps trying</p>
      : runs.length === 0
        ? <p class="runs-empty">no runs recorded yet — "run now" (on the jobs page) fires one.</p>
        : <div class="run-list">
            <div class="run-row run-head">
              <span class="run-when">fired</span><span class="run-origin">origin</span>
              <span class="run-duration">duration</span><span class="run-exit">exit</span>
              <span class="run-log-cell"></span>
            </div>
            {runs.map(run => (
              <div class="run-row">
                <span class="run-when">{fmtRunTime(run.firedAt)}</span>
                <span class="run-origin">{run.origin}</span>
                <span class="run-duration">
                  {run.finishedAt === null ? '—' : fmtDuration(run.firedAt, run.finishedAt)}
                </span>
                {run.exitCode === null
                  ? <span class="run-exit unknown">—</span>
                  : <span class={`run-exit ${run.exitCode === 0 ? 'ok' : 'failed'}`}>
                      exit {run.exitCode}
                    </span>}
                <span class="run-log-cell">
                  {run.hasLog && (
                    <wa-button size="xs" appearance="plain" data-log={run.firedAt}>log</wa-button>
                  )}
                </span>
              </div>
            ))}
          </div>}
  </section>
</div>
