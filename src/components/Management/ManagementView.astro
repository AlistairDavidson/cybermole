---
// ManagementView.astro — the /management page's body, rendered from the
// server's ManagementState (docs/CODE_STYLE.md §7: server-rendered
// first). Rendered by the page (src/pages/management.astro) and by the
// partial (src/pages/partials/management.astro) <management-app>
// refreshes from. Regions marked data-refresh hold plain HTML only — no
// wa-* elements — so the element can swap them by id without
// re-hydrating components; the dialogs live outside those regions.
// `state` is null when the request did not come through the web-pi
// server (astro dev's own render): the regions then say "loading…" and
// the element fetches the partial.
import '@awesome.me/webawesome/dist/components/card/card.js';
import '@awesome.me/webawesome/dist/components/button/button.js';
import '@awesome.me/webawesome/dist/components/icon/icon.js';
import '@awesome.me/webawesome/dist/components/callout/callout.js';
import '@awesome.me/webawesome/dist/components/badge/badge.js';
import '@awesome.me/webawesome/dist/components/details/details.js';
import '@awesome.me/webawesome/dist/components/dialog/dialog.js';
import '@awesome.me/webawesome/dist/components/input/input.js';
import '@awesome.me/webawesome/dist/components/checkbox/checkbox.js';
import WaField from '../form/WaField.astro';
import { zodSchemaToHTMLAttributes } from '../../lib/web/zod.service';
import { ManagementConfirmFormSchema, SHA_RE } from '../../schemas/management';
import type { CommitEntry, EnforcementVerdict, ManagementState, ReleaseRecord } from '../../lib/types';

interface Props {
  state: ManagementState | null;
  /** Why `state` is null when the server could not read it (a
   *  management_state failure) — shown instead of "loading…". */
  error?: string | null;
  commits: CommitEntry[] | null;
  /** why the commit list is unavailable (checkout missing / git error) */
  commitsError?: string | null;
  /** the sha the preview region was rendered for (the picker selection) */
  previewSha?: string | null;
  /** the dry-run verdict for `previewSha`; null when unpicked or failed */
  preview?: EnforcementVerdict | null;
  /** why the preview could not be computed (an enforcement failure) */
  previewError?: string | null;
}
const { state, error = null, commits, commitsError = null, previewSha = null, preview, previewError = null } = Astro.props;

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/+$/, '');

// Native constraints matching the schema the dialog validates with
// (client: validation-enhancer-zod in management-app.ts; server: the
// POST bodies parse with the full schemas in src/schemas/management.ts).
const validation = zodSchemaToHTMLAttributes(ManagementConfirmFormSchema);

const iso = (at: number): string => new Date(at).toISOString();
const serving = state?.serving ?? null;
const checkout = state?.checkout ?? null;
const releases = state?.releases ?? [];
const building = releases.some(r => r.live === 'pending' || r.live === 'building');
const statusOf = (r: ReleaseRecord): string =>
  r.live === 'pending' || r.live === 'building' ? r.live : r.status;
const lastBuild = releases.find(r => r.status !== 'requested') ?? null; // newest first (dbRows): the last build outcome (a 'requested' row has no log yet)
---

<main class="mgmt-main wa-stack wa-gap-m">
  <header class="mgmt-header wa-split">
    <h1><wa-icon name="arrows-rotate"></wa-icon> management</h1>
    <wa-button appearance="plain" size="s" href={`${base}/settings`}>
      <wa-icon slot="start" name="arrow-left" label="back to settings"></wa-icon>
      settings
    </wa-button>
  </header>
  <p class="hint">
    Apply a commit of the workspace checkout to what web serves — and roll it back. The
    <strong>protected set</strong> (the gate, the privilege split, the build inputs, this page's own
    enforcement) is refused by the server no matter what this page shows: those parts change only in
    the original project on the host (<code>docs/management-page.md</code>).
  </p>

  <wa-card class="mgmt-card" with-header>
    <div slot="header" class="wa-split">
      <strong class="card-title">serving now</strong>
      <span class="hint">what this boot resolved to serve</span>
    </div>
    <div id="mgmt-serving" class="wa-stack wa-gap-2xs" data-refresh>
      {!serving
        ? <span class="hint">{error === null ? 'loading…' : `could not load state: ${error}`}</span>
        : <div class="wa-stack wa-gap-2xs">
            <div class="cfg-row wa-split">
              <span class="k">serving</span>
              <span class="v">
                {serving.kind === 'release'
                  ? <Fragment>release <code>{serving.release?.sha.slice(0, 12)}…</code>
                      {serving.release?.builtAt
                        ? <span> (built <time datetime={iso(serving.release.builtAt)}>{iso(serving.release.builtAt)}</time>)</span>
                        : null}</Fragment>
                  : <Fragment>the image copy</Fragment>}
              </span>
            </div>
            {serving.image
              ? <div class="cfg-row wa-split">
                  <span class="k">image</span>
                  <span class="v">
                    v{serving.image.appVersion} ·
                    {SHA_RE.test(serving.image.git) ? <code>{serving.image.git.slice(0, 12)}…</code> : <span>git sha not recorded</span>}
                    {serving.image.builtAt ? <span> · built {serving.image.builtAt}</span> : null}
                  </span>
                </div>
              : <div class="cfg-row wa-split"><span class="k">image</span><span class="v">version.json absent (image built before GIT_SHA wiring)</span></div>}
            {state?.nextBoot
              ? <div class="cfg-row wa-split">
                  <span class="k">next boot</span>
                  <span class="v">release <code>{state.nextBoot.sha.slice(0, 12)}…</code> — restart pending</span>
                </div>
              : null}
            <div class="cfg-row wa-split">
              <span class="k">releases volume</span>
              <span class="v">{state?.releasesDir ? state.releasesDir : 'not mounted — build/activate disabled (dry-run mode)'}</span>
            </div>
          </div>}
    </div>
  </wa-card>

  <wa-card class="mgmt-card" with-header>
    <div slot="header" class="wa-split">
      <strong class="card-title">workspace checkout</strong>
      <span class="hint">read-only git view — what a session can edit</span>
    </div>
    <div id="mgmt-checkout" class="wa-stack wa-gap-2xs" data-refresh>
      {checkout === null && state
        ? <span class="hint">WEB_PI_MANAGEMENT_CHECKOUT is not set — point it at the workspace checkout (compose: /workspace/web-pi).</span>
        : !state
          ? <span class="hint">loading…</span>
          : <div class="wa-stack wa-gap-2xs">
              <div class="cfg-row wa-split"><span class="k">path</span><span class="v">{checkout!.path}</span></div>
              {checkout!.error
                ? <span class="hint">{checkout!.error}</span>
                : <div class="wa-stack wa-gap-3xs">
                    <div class="cfg-row wa-split"><span class="k">HEAD</span><span class="v"><code>{checkout!.head?.slice(0, 12)}…</code>{checkout!.branch ? ` (${checkout!.branch})` : ' (detached)'}</span></div>
                    <div class="cfg-row wa-split"><span class="k">uncommitted</span><span class="v">{checkout!.dirty === null ? 'unknown' : `${checkout!.dirty} file${checkout!.dirty === 1 ? '' : 's'}`}</span></div>
                  </div>}
            </div>}
    </div>
  </wa-card>

  <wa-card class="mgmt-card" with-header>
    <div slot="header" class="wa-split">
      <strong class="card-title">apply a commit</strong>
      <span class="hint">pick → preview (the verdict before anything runs) → build → activate</span>
    </div>
    <div class="wa-stack wa-gap-s">
      <div id="mgmt-commits" class="wa-stack wa-gap-2xs" data-refresh>
        {commitsError
          ? <span class="hint">{commitsError}</span>
          : !state
            ? <span class="hint">loading…</span>
            : commits === null || commits.length === 0
              ? <span class="hint">no commits listed — the checkout is missing or empty (see above).</span>
              : <ul class="mgmt-commits">
                  {commits.map(c => (
                    <li>
                      <button
                        type="button"
                        class="mgmt-commit"
                        data-pick={c.sha}
                        data-selected={previewSha === c.sha ? 'true' : undefined}
                      >
                        <span class="t"><code>{c.short}</code> {c.subject}</span>
                        <span class="d">{c.author} · {c.date}</span>
                      </button>
                    </li>
                  ))}
                </ul>}
      </div>

      <div id="mgmt-preview" class="wa-stack wa-gap-2xs" data-refresh data-sha={previewSha ?? undefined}>
        {!state
          ? <span class="hint">loading…</span>
          : !previewSha
            ? <span class="hint">pick a commit to see what applying it would change.</span>
            : previewError
              ? <span class="mgmt-verdict blocked" role="alert">{previewError}</span>
              : preview && <div class="wa-stack wa-gap-2xs">
                  <div class="wa-split">
                    <span class={`mgmt-verdict ${preview.allowed ? 'ok' : 'blocked'}`}>
                      {preview.allowed
                        ? <Fragment><wa-icon name="circle-check"></wa-icon> allowed — {preview.changedCount} path{preview.changedCount === 1 ? '' : 's'} change, none protected</Fragment>
                        : <Fragment><wa-icon name="triangle-exclamation"></wa-icon> REFUSED — the protected set changes</Fragment>}
                    </span>
                    <span class="hint">diff <code>{preview.base.slice(0, 8)}…</code> → <code>{preview.target.slice(0, 8)}…</code></span>
                  </div>
                  {preview.protectedChanged.length > 0
                    ? <ul class="mgmt-protected" role="alert">
                        {preview.protectedChanged.map(p => (
                          <li>
                            <code>{p}</code>
                            {preview.protectedWhy[p] ? <span> — {preview.protectedWhy[p]}</span> : null}
                          </li>
                        ))}
                      </ul>
                    : null}
                  {preview.changed.length > 0
                    ? <ul class="mgmt-changed">
                        {preview.changed.map(ch => (
                          <li><span class={`st st-${ch.status.toLowerCase()}`}>{ch.status}</span> <code>{ch.path}</code></li>
                        ))}
                        {preview.changedCount > preview.changed.length
                          ? <li class="hint">… {preview.changedCount - preview.changed.length} more (list capped)</li>
                          : null}
                      </ul>
                    : <span class="hint">no changes at all — activating this would serve the same content.</span>}
                  {preview.allowed && state.releasesDir !== null
                    ? <div class="wa-cluster wa-gap-2xs">
                        <button type="button" class="mgmt-cta" data-build={preview.target}>
                          build this commit
                        </button>
                      </div>
                    : preview.allowed
                      ? <span class="hint">the releases volume is not mounted — build/activate need the compose wiring (docs/management-page.md §7).</span>
                      : <span class="hint">the protected set only changes in the original project on the host.</span>}
                </div>}
      </div>
    </div>
  </wa-card>

  <wa-card class="mgmt-card" with-header>
    <div slot="header" class="wa-split">
      <strong class="card-title">builds &amp; releases</strong>
      <span class="hint">{building ? 'a build is running — watching' : 'history, activate, rollback'}</span>
    </div>
    <div id="mgmt-releases" class="wa-stack wa-gap-s" data-refresh>
      {!state
        ? <span class="hint">loading…</span>
        : releases.length === 0
          ? <span class="hint">nothing built yet.</span>
          : <table class="mgmt-table">
              <thead><tr><th scope="col">commit</th><th scope="col">status</th><th scope="col">requested</th><th scope="col">applied</th><th scope="col"></th></tr></thead>
              <tbody>
                {releases.map(r => (
                  <tr>
                    <td><code>{r.sha.slice(0, 12)}…</code></td>
                    <td>
                      <span class={`mgmt-status st-${statusOf(r)}`}>{statusOf(r)}</span>
                    </td>
                    <td>{r.requestedAt ? <time datetime={iso(r.requestedAt)}>{iso(r.requestedAt)}</time> : '—'}</td>
                    <td>{r.appliedAt ? <time datetime={iso(r.appliedAt)}>{iso(r.appliedAt)}</time> : '—'}</td>
                    <td>
                      {(r.status === 'built' || r.status === 'applied') && (r.live === undefined || r.live === 'built' || r.live === 'none')
                        ? <button type="button" class="mgmt-cta" data-activate={r.sha}>
                            {serving?.release?.sha === r.sha ? 're-activate' : 'activate'}
                          </button>
                        : null}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>}
      {serving?.kind === 'release'
        ? <div class="wa-split">
            <span class="hint">roll back to the image copy (the running gate never changes — this only re-points what it serves).</span>
            <button type="button" class="mgmt-cta danger" data-activate="image">roll back to image</button>
          </div>
        : null}
    </div>
    <wa-details id="mgmt-build-log" summary="last build log" class={lastBuild?.log ? undefined : 'hidden'}>
      <pre class="npm-output" id="mgmt-build-log-text" data-refresh>{lastBuild?.log ?? ''}</pre>
    </wa-details>
  </wa-card>

  <wa-callout id="mgmt-restart" class="hidden">
    <span id="mgmt-restart-text">activating — the server is restarting; this page will reload when it answers.</span>
  </wa-callout>
</main>

<wa-dialog id="mgmt-dialog" label="confirm a dangerous action" with-footer>
  <div class="wa-stack wa-gap-s">
    <p id="mgmt-dialog-text" class="dialog-text"></p>
    <validation-enhancer-zod>
      <form id="mgmt-form" class="wa-stack wa-gap-s" novalidate>
        <WaField id="mgmt-username" name="username" label="username" autocomplete="username" {...validation.username} />
        <WaField id="mgmt-password" name="password" label="password" type="password" autocomplete="current-password"
          hint="re-enter your web-pi login — a live cookie alone cannot swap the server" {...validation.password} />
      </form>
    </validation-enhancer-zod>
    <wa-checkbox id="mgmt-confirm-box">I understand this restarts the web server</wa-checkbox>
    <span id="mgmt-confirm-error" class="field-error" aria-live="polite"></span>
  </div>
  <wa-button slot="footer" appearance="plain" data-dialog="close">cancel</wa-button>
  <wa-button slot="footer" id="mgmt-confirm-ok" variant="danger">
    <wa-icon slot="start" name="rotate-right"></wa-icon>
    <span id="mgmt-confirm-label">confirm</span>
  </wa-button>
</wa-dialog>
