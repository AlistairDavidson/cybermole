---
// SettingsView.astro — the /settings dashboard, rendered from the server's
// SettingsState (docs/CODE_STYLE.md §7: server-rendered first). Rendered by
// the page (src/pages/settings.astro) and by the partial <settings-app>
// refreshes from (src/pages/partials/settings.astro). Regions marked
// data-refresh hold plain HTML only — no wa-* elements — so the element
// can swap them by id without re-hydrating components. `state` is null
// only for a failed settings_state read (the page and the partial render
// inside the web-pi server or not at all): the configuration card then
// carries the reason; the status lines show unknown (…).
import '@awesome.me/webawesome/dist/components/card/card.js';
import '@awesome.me/webawesome/dist/components/button/button.js';
import '@awesome.me/webawesome/dist/components/icon/icon.js';
import '@awesome.me/webawesome/dist/components/callout/callout.js';
import '@awesome.me/webawesome/dist/components/badge/badge.js';
import '@awesome.me/webawesome/dist/components/details/details.js';
import '@awesome.me/webawesome/dist/components/switch/switch.js';
import type { SettingsState } from '../../lib/types';

interface Props {
  state: SettingsState | null;
  /** why `state` is null — a failed settings_state read (the
   *  configuration card shows it). */
  error?: string | null;
}
const { state, error = null } = Astro.props;

const rows: Array<[string, string]> = state ? [
  ['web-pi', `v${state.appVersion}`],
  ['node', state.nodeVersion],
  ['listen', `${state.host}:${state.port}`],
  ['url base', state.base],
  ['terminal command', state.command],
  ['default workspace cwd', state.newSessionCwd],
  ['pi agent dir', state.agentDir],
  ['state db', state.stateDb],
  ['tmux socket', state.tmuxSocket],
  ['tmux conf', state.tmuxConf ?? '(not present — tmux defaults)'],
  ['install dir', state.appRoot],
] : [];
const au = state?.piAutoUpdate ?? null;
const iso = (at: number): string => new Date(at).toISOString();
// Boolean attributes on wa-*: astro-lit renders `x={false}` as x="false"
// and `x={undefined}` as x="undefined" — PRESENT attributes, i.e. true.
// Spread the attribute in only when it is on.
const flag = (name: string, on: boolean): Record<string, true> => (on ? { [name]: true } : {});
const npmMissing = !state || !state.npmAvailable;
---
<main class="settings-main wa-stack wa-gap-m">
  <header class="settings-header">
    <h1><wa-icon name="gear"></wa-icon> settings</h1>
  </header>

  <wa-card class="settings-card" with-header>
    <div slot="header" class="wa-split">
      <strong class="card-title">configuration</strong>
      <span class="hint">effective values (defaults where no WEB_PI_* override is set)</span>
    </div>
    <div id="config" class="wa-stack wa-gap-2xs" data-refresh>
      {state
        ? rows.map(([k, v]) => <div class="cfg-row wa-split"><span class="k">{k}</span><span class="v">{v}</span></div>)
        : <span class="hint">could not load settings: {error}</span>}
    </div>
  </wa-card>

  <wa-card class="settings-card" with-header>
    <div slot="header" class="wa-split">
      <strong class="card-title">pi</strong>
      <wa-badge id="pi-badge"><span id="pi-badge-text" data-refresh>pi {state ? (state.piInstalled ?? 'not installed') : '…'}</span></wa-badge>
    </div>
    <div class="wa-stack wa-gap-s">
      <div class="wa-split">
        <div class="wa-stack wa-gap-3xs">
          <span class="hint" id="pi-declared" data-refresh>
            {state ? `declared ${state.piDeclared} (${state.piPackage})` : 'declared …'}
          </span>
          <span class="hint">runs <code>npm install @earendil-works/pi-coding-agent@latest</code> in the app's install dir</span>
        </div>
        <wa-button id="update-pi" variant="brand" size="s" {...flag('disabled', npmMissing)}>
          <wa-icon slot="start" name="rotate-right"></wa-icon>
          update pi
        </wa-button>
      </div>
      <div class="wa-split">
        <div class="wa-stack wa-gap-3xs">
          <span class="hint">checks daily and installs the newest pi <em>within the declared range</em> —
            never a restart; running sessions keep their version</span>
          <span class="hint" id="auto-check-line" data-refresh>
            {!au ? '…' : au.lastCheck
              ? <Fragment>last check <time datetime={iso(au.lastCheck.at)}>{iso(au.lastCheck.at)}</time> — {au.lastCheck.detail}</Fragment>
              : 'not checked yet'}
          </span>
          <span class="hint" id="auto-update-line" data-refresh>
            {!au ? '…' : au.lastUpdate
              ? <Fragment>last update <time datetime={iso(au.lastUpdate.at)}>{iso(au.lastUpdate.at)}</time> — {au.lastUpdate.detail}</Fragment>
              : 'no auto-update has run yet'}
          </span>
        </div>
        <wa-switch id="pi-auto-update" {...flag('checked', au?.enabled ?? false)} {...flag('disabled', npmMissing)}>auto-update</wa-switch>
      </div>
      <wa-callout id="auto-result" class="hidden"></wa-callout>
      <wa-details id="auto-update-output" summary="last auto-update npm output" open
        class={au?.lastUpdate?.output ? undefined : 'hidden'}>
        <pre class="npm-output" id="auto-update-output-text" data-refresh>{au?.lastUpdate?.output ?? ''}</pre>
      </wa-details>
      <p id="npm-missing" data-refresh class={state && !state.npmAvailable ? 'hint' : 'hint hidden'}>
        npm was not found on the server's PATH — updating from here needs npm in the server's environment.
      </p>
      <!-- Flags the element applies to the controls (the switch and the
           update button) after a refresh — plain data, no wa-* inside. -->
      <span id="pi-flags" data-refresh hidden
        data-npm-available={state?.npmAvailable ? 'true' : 'false'}
        data-auto-enabled={au?.enabled ? 'true' : 'false'}></span>
      <wa-callout id="update-result" class="hidden"></wa-callout>
      <wa-details id="update-output" summary="npm output" class="hidden">
        <pre class="npm-output"></pre>
      </wa-details>
      <p class="hint">
        The manual button installs <code>@latest</code> (stay within the declared
        <code>^1</code> range — the app's session code is written against that major);
        auto-update always stays inside it. New sessions use the updated pi
        straight away; running sessions keep the version they started with. In the
        Docker dev profile node_modules is a shadow volume — updates from here may
        not survive the next container boot (README → Updating).
      </p>
    </div>
  </wa-card>

  <wa-card class="settings-card" with-header>
    <div slot="header" class="wa-split">
      <strong class="card-title">session</strong>
      <span class="hint">sessions last 7 days idle, 30 days from login</span>
    </div>
    <div class="wa-split">
      <div class="wa-stack wa-gap-3xs">
        <span>log out everywhere</span>
        <span class="hint">ends every signed-in browser (all tabs, all devices), closes their terminals</span>
      </div>
      <wa-button id="logout-all" variant="danger" size="s">
        <wa-icon slot="start" name="right-from-bracket"></wa-icon>
        log out everywhere
      </wa-button>
    </div>
    <wa-callout id="logout-result" variant="danger" class="hidden"></wa-callout>
  </wa-card>
</main>
