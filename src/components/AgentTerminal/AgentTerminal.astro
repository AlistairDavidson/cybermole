---
// The pane's markup, for every host (the console's tab and run panes via
// TerminalTabs' skeleton, /view's single pane): the xterm box, the overlay
// toolbar (find bar + actions menu), and the status line with one indicator per
// kind. agent-terminal.ts fills and toggles it; tooltip ids are assigned
// per instance there, since a skeleton is cloned many times.
import '@awesome.me/webawesome/dist/components/button/button.js';
import '@awesome.me/webawesome/dist/components/dropdown/dropdown.js';
import '@awesome.me/webawesome/dist/components/dropdown-item/dropdown-item.js';
import '@awesome.me/webawesome/dist/components/icon/icon.js';
import '@awesome.me/webawesome/dist/components/input/input.js';
import '@awesome.me/webawesome/dist/components/spinner/spinner.js';
import '@awesome.me/webawesome/dist/components/divider/divider.js';
---
<agent-terminal>
  <div class="terminal-container"></div>
  <div class="terminal-toolbar wa-stack wa-gap-2xs wa-align-items-end" role="toolbar" aria-label="terminal actions">
    <div class="terminal-find wa-cluster hidden">
      <wa-input
        class="terminal-find-input"
        placeholder="find in terminal…"
        size="s"
        aria-label="find in terminal"></wa-input>
      <wa-button class="find-prev" appearance="plain" size="xs">
        <wa-icon name="chevron-up" label="previous match"></wa-icon>
      </wa-button>
      <wa-tooltip data-tip="find-prev">previous match (shift+enter)</wa-tooltip>
      <wa-button class="find-next" appearance="plain" size="xs">
        <wa-icon name="chevron-down" label="next match"></wa-icon>
      </wa-button>
      <wa-tooltip data-tip="find-next">next match (enter)</wa-tooltip>
      <wa-button class="find-close" appearance="plain" size="xs">
        <wa-icon name="xmark" label="close find bar"></wa-icon>
      </wa-button>
      <wa-tooltip data-tip="find-close">close (esc)</wa-tooltip>
    </div>
    <!-- attach() reveals the tab actions for 'terminal' mode only: a run
         pane has no tab. -->
    <wa-dropdown class="tb-menu" placement="bottom-end" size="s">
      <wa-button slot="trigger" class="tb-trigger" appearance="plain" size="xs">
        <wa-icon name="screwdriver-wrench" label="terminal actions"></wa-icon>
      </wa-button>
      <wa-dropdown-item value="up">
        <wa-icon slot="icon" name="arrow-up" aria-hidden="true"></wa-icon>send up arrow
      </wa-dropdown-item>
      <wa-dropdown-item value="down">
        <wa-icon slot="icon" name="arrow-down" aria-hidden="true"></wa-icon>send down arrow
      </wa-dropdown-item>
      <wa-dropdown-item value="esc">
        <wa-icon slot="icon" name="arrow-right-from-bracket" aria-hidden="true"></wa-icon>send escape
      </wa-dropdown-item>
      <wa-divider></wa-divider>
      <wa-dropdown-item value="copy-output">
        <wa-icon slot="icon" name="copy" aria-hidden="true"></wa-icon>copy output
        <span slot="details">plain text</span>
      </wa-dropdown-item>
      <wa-dropdown-item value="download-transcript">
        <wa-icon slot="icon" name="download" aria-hidden="true"></wa-icon>download transcript
        <span slot="details">ANSI</span>
      </wa-dropdown-item>
      <wa-divider class="tb-tab-action hidden"></wa-divider>
      <wa-dropdown-item value="pop-out" class="tb-tab-action hidden" disabled>
        <wa-icon slot="icon" name="arrow-up-right-from-square" aria-hidden="true"></wa-icon>pop out to a browser tab
      </wa-dropdown-item>
      <wa-dropdown-item value="close" variant="danger" class="tb-tab-action hidden" disabled>
        <wa-icon slot="icon" name="xmark" aria-hidden="true"></wa-icon>close terminal
        <span slot="details">ends its session</span>
      </wa-dropdown-item>
    </wa-dropdown>
    <wa-tooltip data-tip="tb-trigger">terminal actions</wa-tooltip>
    <!-- The download's target; never shown, clicked from code. -->
    <a class="tb-download-link hidden" aria-hidden="true" tabindex="-1"></a>
  </div>
  <wa-divider></wa-divider>
  <div class="terminal-status wa-cluster wa-gap-2xs wa-flex-nowrap wa-caption-xs">
    <wa-spinner data-kind="busy" class="hidden"></wa-spinner>
    <wa-icon data-kind="ok" name="circle-check" class="hidden"></wa-icon>
    <wa-icon data-kind="err" name="triangle-exclamation" class="hidden"></wa-icon>
    <wa-icon data-kind="info" name="circle-info" class="hidden"></wa-icon>
    <span class="status-text"></span>
  </div>
</agent-terminal>

<script>
  // Support modules first — see ConsoleApp.astro for why.
  import '@awesome.me/astro-lit/dsd-polyfill.js';
  import '@awesome.me/astro-lit/hydration-support.js';
  import '../../icons';
  import './agent-terminal.ts';
</script>
