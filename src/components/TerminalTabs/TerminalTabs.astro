---
// The workspace's tab strip and panes on a wa-tab-group. Everything the
// enhancer (terminal-tabs.ts) shows is authored here: the static views
// (the empty states, the run host, the new-tab split button) are SSR'd,
// and the per-terminal structures are inert <template> skeletons it
// clones and fills by class hooks. Nothing is visible until the console
// state arrives (view="loading"); the enhancer flips `view` and the
// .hidden classes from then on.
import '@awesome.me/webawesome/dist/components/tab-group/tab-group.js';
import '@awesome.me/webawesome/dist/components/tab/tab.js';
import '@awesome.me/webawesome/dist/components/tab-panel/tab-panel.js';
import '@awesome.me/webawesome/dist/components/button/button.js';
import '@awesome.me/webawesome/dist/components/button-group/button-group.js';
import '@awesome.me/webawesome/dist/components/dropdown/dropdown.js';
import '@awesome.me/webawesome/dist/components/dropdown-item/dropdown-item.js';
import '@awesome.me/webawesome/dist/components/icon/icon.js';
import AgentTerminal from '../AgentTerminal/AgentTerminal.astro';
---
<terminal-tabs view="loading">
  <!-- manual activation: arrows walk focus, Enter/Space/click select —
       a selection is an attach, so focus alone must not open a pane. -->
  <wa-tab-group class="hidden" activation="manual" without-scroll-controls>
    <wa-button-group slot="nav" class="tab-new-group wa-align-self-center" label="new tab">
      <wa-button
        id="tab-new"
        class="tab-new"
        appearance="plain"
        size="s"
        aria-label="new shell tab"
      >
        <wa-icon name="plus" label="new shell tab"></wa-icon>
      </wa-button>
      <wa-dropdown class="tab-new-menu" placement="bottom-end">
        <wa-button
          slot="trigger"
          id="tab-new-caret"
          class="tab-new-caret"
          appearance="plain"
          size="s"
          aria-label="new tab options"
        >
          <wa-icon name="chevron-down" label="new tab options"></wa-icon>
        </wa-button>
        <wa-dropdown-item value="shell">
          <wa-icon slot="icon" name="terminal" aria-hidden="true"></wa-icon>
          new shell tab
          <span slot="details">ctrl t</span>
        </wa-dropdown-item>
        <wa-dropdown-item value="agent">
          <wa-icon slot="icon" name="robot" aria-hidden="true"></wa-icon>
          new agent tab
          <span slot="details">ctrl shift t</span>
        </wa-dropdown-item>
      </wa-dropdown>
    </wa-button-group>
  </wa-tab-group>

  <div class="tabs-empty tabs-empty-nows wa-stack wa-align-items-center wa-justify-content-center wa-gap-s hidden" data-view="no-workspace">
    <wa-icon name="folder" class="wa-font-size-l"></wa-icon>
    <p class="wa-caption-m">no workspace selected</p>
    <wa-button size="s" class="empty-new-workspace">
      <wa-icon slot="start" name="plus"></wa-icon>new workspace
    </wa-button>
  </div>
  <div class="tabs-empty tabs-empty-terminals wa-stack wa-align-items-center wa-justify-content-center wa-gap-s hidden" data-view="no-terminals">
    <wa-icon name="terminal" class="wa-font-size-l"></wa-icon>
    <p class="wa-caption-m">no terminals in this workspace yet</p>
    <wa-button size="s" class="empty-new-terminal">
      <wa-icon slot="start" name="plus"></wa-icon>new terminal
    </wa-button>
  </div>
  <div class="run-host hidden" data-view="run"></div>
  <!-- Out here, not in the tabs: a tooltip inside a wa-tab would join the
       tab's text, one inside a panel hides with it. A tooltip binds its
       anchor on connect, so stamped anchors get theirs stamped after. -->
  <div class="tab-tips">
    <wa-tooltip for="tab-new">new shell tab</wa-tooltip>
    <wa-tooltip for="tab-new-caret">new tab options</wa-tooltip>
  </div>

  <template data-tab>
    <wa-tab
      slot="nav"
      class="tab"
      draggable="true"
      aria-keyshortcuts="Shift+ArrowLeft Shift+ArrowRight"
    >
      <span class="tab-label truncate"></span>
      <wa-button
        class="tab-close"
        appearance="plain"
        size="xs"
        tabindex="-1"
      >
        <wa-icon name="xmark" label="close terminal"></wa-icon>
      </wa-button>
    </wa-tab>
  </template>
  <template data-close-tip>
    <wa-tooltip>close this terminal</wa-tooltip>
  </template>
  <template data-editor-tab-tip>
    <wa-tooltip>open the workspace folder in the editor</wa-tooltip>
  </template>
  <template data-editor-pop-tip>
    <wa-tooltip>pop out — open this workspace's editor in its own browser tab</wa-tooltip>
  </template>
  <template data-panel>
    <wa-tab-panel class="term-panel"></wa-tab-panel>
  </template>
  <template data-pane>
    <AgentTerminal />
  </template>
  <template data-popped>
    <div class="tabs-empty tabs-popped wa-stack wa-align-items-center wa-justify-content-center wa-gap-s">
      <wa-icon name="arrow-up-right-from-square" class="wa-font-size-l"></wa-icon>
      <p class="wa-caption-m">popped out to its own tab — click the tab to bring it back here</p>
    </div>
  </template>
  <template data-editor-tab>
    <wa-tab
      slot="nav"
      class="tab editor-tab"
      panel="editor"
      data-term="editor"
      id="tab-editor"
    >
      <wa-icon name="code" aria-hidden="true"></wa-icon>
      <span class="tab-label">editor</span>
    </wa-tab>
  </template>
  <template data-editor-panel>
    <wa-tab-panel name="editor" class="editor-host">
      <div class="editor-toolbar wa-cluster wa-justify-content-end wa-gap-3xs" role="toolbar" aria-label="editor actions">
        <wa-button
          id="editor-pop-out"
          class="tb-pop-out"
          appearance="plain"
          variant="neutral"
          size="xs"
        >
          <wa-icon slot="start" name="arrow-up-right-from-square" aria-hidden="true"></wa-icon>
          pop out
        </wa-button>
      </div>
      <iframe class="editor-frame" title="editor"></iframe>
    </wa-tab-panel>
  </template>
</terminal-tabs>
