---
// The global header bar. Section links are wa-buttons with href, so they're
// real anchors that work without JS; app-header.ts wires sign-out. The wa-*
// imports here only SSR; the client script re-imports (AGENTS.md).
import '@awesome.me/webawesome/dist/components/button/button.js';
import '@awesome.me/webawesome/dist/components/icon/icon.js';

type Section = 'console' | 'builder' | 'jobs' | 'logs' | 'settings';
interface Props {
  current: Section;
  /** Set only when CYBERMOLE_GRAFANA_URL is configured. */
  logs?: boolean;
}
const { current, logs = false } = Astro.props;

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/+$/, '');

const logsEntries: Array<{ section: Section; label: string; href: string; icon: string }> = logs
  ? [{ section: 'logs', label: 'logs', href: `${base}/logs`, icon: 'file-lines' }]
  : [];

const links: Array<{ section: Section; label: string; href: string; icon: string }> = [
  { section: 'console', label: 'cybermole', href: `${base}/`, icon: 'terminal' },
  { section: 'builder', label: 'builder', href: `${base}/builder`, icon: 'cubes' },
  { section: 'jobs', label: 'jobs', href: `${base}/jobs`, icon: 'clock' },
  ...logsEntries,
  { section: 'settings', label: 'settings', href: `${base}/settings`, icon: 'gear' },
];
const left = links.filter(l => l.section !== 'settings');
const right = links.filter(l => l.section === 'settings');
---
<app-header>
  <nav class="wa-cluster wa-gap-2xs" aria-label="cybermole">
    {left.map(l => (
      <wa-button
        class={l.section === 'console' ? 'app-nav-link app-brand' : 'app-nav-link'}
        appearance="plain"
        size="s"
        href={l.href}
        {...(l.section === current ? { 'aria-current': 'page' } : {})}
      >
        <wa-icon slot="start" name={l.icon}></wa-icon>
        {l.label}
      </wa-button>
    ))}
  </nav>
  <div class="wa-cluster wa-gap-2xs">
    {right.map(l => (
      <wa-button
        class="app-nav-link"
        appearance="plain"
        size="s"
        href={l.href}
        {...(l.section === current ? { 'aria-current': 'page' } : {})}
      >
        <wa-icon slot="start" name={l.icon}></wa-icon>
        {l.label}
      </wa-button>
    ))}
    <wa-button id="sign-out" appearance="plain" size="s">
      <wa-icon slot="start" name="right-from-bracket"></wa-icon>
      sign out
    </wa-button>
  </div>
</app-header>

<script>
  // Must precede any wa-* import, or SSR'd elements render twice.
  import '@awesome.me/astro-lit/dsd-polyfill.js';
  import '@awesome.me/astro-lit/hydration-support.js';
  import '../../icons';
  import './app-header';
</script>
