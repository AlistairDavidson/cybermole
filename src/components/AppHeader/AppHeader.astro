---
// The global header bar. Section links are wa-buttons with href, so they're
// real anchors that work without JS; app-header.ts wires sign-out. The wa-*
// imports here only SSR; the client script re-imports (AGENTS.md).
import '@awesome.me/webawesome/dist/components/button/button.js';
import '@awesome.me/webawesome/dist/components/icon/icon.js';

type Section = 'console' | 'builder' | 'jobs' | 'logs' | 'settings';
interface Props {
  current: Section;
  /** Set only when CYBERMOLE_GRAFANA_URL is configured. */
  logs?: boolean;
}

type MenuItem = {
  section: Section;
  label: string;
  href: string;
  icon: string;
  className?: string;
};

const { current, logs = false } = Astro.props;

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/+$/, '');

const logsEntries: MenuItem[] = logs
  ? [{ section: 'logs', label: 'Logs', href: `${base}/logs`, icon: 'file-lines' }]
  : [];

const left: MenuItem[] =  [
  { section: 'console', label: 'Cybermole', href: `${base}/`, icon: 'cybermole', className: 'app-nav-link app-brand' },
  { section: 'builder', label: 'Builder', href: `${base}/builder`, icon: 'cubes' },
  { section: 'jobs', label: 'Jobs', href: `${base}/jobs`, icon: 'clock' },
  ...logsEntries,
]

const right: MenuItem[] = [
  { section: 'settings', label: 'settings', href: `${base}/settings`, icon: 'gear' }
];

---
<app-header>
  <nav class="wa-cluster wa-gap-2xs">
    <!-- The mobile drawer toggle, far left where the thumb lives. Dumb
         markup: CSS shows it only on the console pages (a wa-page drawer to
         open) below wa-page's mobile breakpoint, and app-header.ts announces
         clicks as a toggle-nav event for console-app to answer. -->
    <wa-button
      id="nav-drawer-toggle"
      class="nav-drawer-toggle"
      appearance="plain"
      size="s"
      title="open the workspace drawer"
      aria-label="open the workspace drawer"
      aria-expanded="false"
    >
      <wa-icon name="bars" label="open the workspace drawer"></wa-icon>
    </wa-button>
    {left.map(l => (
      <wa-button
        class={l.className ? l.className : 'app-nav-link'}
        appearance="plain"
        size="s"
        href={l.href}
        title={l.label}
        {...(l.section === current ? { 'aria-current': 'page' } : {})}
      >
        {
        l.icon === "cybermole" ? (
            // The brand glyph, monochrome: the art's ink (dome, outlines,
            // claws, nose) in currentColor with its light shapes cut as
            // mask holes, so the page-current highlight colours it exactly
            // like its sibling icons (a raster icon can't take the colour).
            <svg slot="start" class="app-brand-icon" viewBox="0 0 512 512" aria-hidden="true">
              <mask id="app-brand-holes" maskUnits="userSpaceOnUse">
                <rect width="512" height="512" fill="#fff"></rect>
                <rect x="154.6" y="209.2" width="206" height="19.8" fill="#000"></rect>
                <circle cx="256.4" cy="327" r="56" fill="#000"></circle>
                <ellipse cx="73.4" cy="515.7" rx="56" ry="84" fill="#000"></ellipse>
                <ellipse cx="439.4" cy="515.7" rx="56" ry="84" fill="#000"></ellipse>
              </mask>
              <ellipse
                cx="256.4"
                cy="557.9"
                rx="192"
                ry="448"
                fill="currentColor"
                stroke="currentColor"
                stroke-width="21.6"
                mask="url(#app-brand-holes)"></ellipse>
              <ellipse cx="73.4" cy="515.7" rx="64" ry="92" fill="none" stroke="currentColor" stroke-width="16"></ellipse>
              <ellipse cx="439.4" cy="515.7" rx="64" ry="92" fill="none" stroke="currentColor" stroke-width="16"></ellipse>
              <rect x="44.2" y="472.8" width="17" height="48" fill="currentColor"></rect>
              <rect x="85.7" y="472.9" width="17" height="48" fill="currentColor"></rect>
              <rect x="410.2" y="472.8" width="17" height="48" fill="currentColor"></rect>
              <rect x="451.7" y="472.9" width="17" height="48" fill="currentColor"></rect>
              <circle cx="256.4" cy="327" r="64" fill="none" stroke="currentColor" stroke-width="16"></circle>
              <circle cx="256.4" cy="357.8" r="24" fill="currentColor"></circle>
            </svg>
          )
          :
            <wa-icon slot="start" name={l.icon}></wa-icon>
        }
      </wa-button>
    ))}
  </nav>
  <div class="wa-cluster wa-gap-2xs">
    {right.map(l => (
      <wa-button
        class="app-nav-link"
        appearance="plain"
        size="s"
        href={l.href}
        title={l.label}
        {...(l.section === current ? { 'aria-current': 'page' } : {})}
      >
        <wa-icon slot="start" name={l.icon}></wa-icon>
      </wa-button>
    ))}
    <wa-button id="sign-out" appearance="plain" size="s" title="Sign Out">
      <wa-icon slot="start" name="right-from-bracket"></wa-icon>
    </wa-button>
  </div>
</app-header>

<script>
  // Must precede any wa-* import, or SSR'd elements render twice.
  import '@awesome.me/astro-lit/dsd-polyfill.js';
  import '@awesome.me/astro-lit/hydration-support.js';
  import '../../icons';
  import './app-header';
</script>
