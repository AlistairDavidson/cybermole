---
// The global header bar. Section links are wa-buttons with href, so they're
// real anchors that work without JS; app-header.ts wires sign-out. The wa-*
// imports here only SSR; the client script re-imports (AGENTS.md).
import '@awesome.me/webawesome/dist/components/button/button.js';
import '@awesome.me/webawesome/dist/components/icon/icon.js';
import '@awesome.me/webawesome/dist/components/tooltip/tooltip.js';
import NavLink from './NavLink.astro';
import type { MenuItem, Section } from './nav';

interface Props {
  current: Section;
  /** Set only when CYBERMOLE_GRAFANA_URL is configured. */
  logs?: boolean;
}


const { current, logs = false } = Astro.props;

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/+$/, '');

const logsEntries: MenuItem[] = logs
  ? [{ section: 'logs', label: 'Logs', href: `${base}/logs`, icon: 'file-lines' }]
  : [];

const left: MenuItem[] =  [
  { section: 'console', label: 'Cybermole', href: `${base}/`, icon: 'cybermole', className: 'app-nav-link app-brand' },
  { section: 'builder', label: 'Builder', href: `${base}/builder`, icon: 'cubes' },
  { section: 'jobs', label: 'Jobs', href: `${base}/jobs`, icon: 'clock' },
  ...logsEntries,
]

const right: MenuItem[] = [
  { section: 'settings', label: 'settings', href: `${base}/settings`, icon: 'gear' }
];

---
<app-header slot="header" class="wa-split wa-gap-s">
  <nav class="wa-cluster wa-gap-2xs">
    <!-- The mobile drawer toggle, far left where the thumb lives.
         wa-page wires any data-toggle-nav button in its light DOM; its
         base styles hide it on desktop, console.css on pages without a
         drawer. app-header.ts mirrors nav-open onto its semantics. -->
    <wa-button
      id="nav-drawer-toggle"
      class="nav-drawer-toggle"
      data-toggle-nav
      appearance="plain"
      size="s"
      aria-label="open the workspace drawer"
      aria-expanded="false"
    >
      <wa-icon name="bars" label="open the workspace drawer"></wa-icon>
    </wa-button>
    {left.map(l => <NavLink item={l} current={current} />)}
  </nav>
  <div class="wa-cluster wa-gap-2xs">
    {right.map(l => <NavLink item={l} current={current} />)}
    <wa-button id="sign-out" appearance="plain" size="s">
      <wa-icon slot="start" name="right-from-bracket" label="Sign Out"></wa-icon>
    </wa-button>
    <wa-tooltip for="sign-out">Sign Out</wa-tooltip>
  </div>
</app-header>

<script>
  // Must precede any wa-* import, or SSR'd elements render twice.
  import '@awesome.me/astro-lit/dsd-polyfill.js';
  import '@awesome.me/astro-lit/hydration-support.js';
  import '../../icons';
  import './app-header';
</script>
