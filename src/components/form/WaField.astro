---
// A wa-input (or wa-textarea) whose validation message lives in its hint
// slot. The real input is in the shadow DOM, so aria-errormessage on the
// host never reaches it, but its aria-describedby points at the hint slot,
// so a message there is announced. The enhancer finds the message element
// via aria-errormessage; `error` pre-fills it. Pages must still import the
// wa-* module client-side (AGENTS.md).
import '@awesome.me/webawesome/dist/components/input/input.js';
import '@awesome.me/webawesome/dist/components/textarea/textarea.js';

interface Props {
  name: string;
  id?: string;
  label: string;
  hint?: string;
  error?: string | undefined;
  as?: 'input' | 'textarea';
  [key: string]: unknown;
}

const { name, id = name, label, hint, error, as = 'input', ...attrs } = Astro.props;
const Control = as === 'textarea' ? 'wa-textarea' : 'wa-input';
const errorId = `${id}-error`;
---
<Control id={id} name={name} label={label} aria-errormessage={errorId} with-hint {...attrs}>
  <div slot="hint" class="field-hint wa-stack wa-gap-3xs">
    {hint && <span class="field-hint-text">{hint}</span>}
    <span id={errorId} class="field-error">{error}</span>
  </div>
</Control>
