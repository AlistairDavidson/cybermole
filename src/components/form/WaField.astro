---
// WaField.astro — a <wa-input> (or, with as="textarea", a <wa-textarea>)
// whose validation message lives in its hint slot (the soothing-booking
// SbInput idea, on Web Awesome; docs/conventions/CODE_STYLE.md §8). Why the hint slot:
// the real <input>/<textarea> is inside the wa-* element's shadow DOM, so
// aria-errormessage / aria-invalid on the host never reach it — but its
// aria-describedby points at the hint slot, so a message slotted there is
// announced with the field.
// validation-enhancer(-zod) finds the message element through
// aria-errormessage (an id lookup inside the enhancer) and writes into it;
// `error` pre-fills it (a server-rendered failure).
// Client side, the page must still import the wa-input / wa-textarea
// module (AGENTS.md: SSR imports ≠ client imports).
import '@awesome.me/webawesome/dist/components/input/input.js';
import '@awesome.me/webawesome/dist/components/textarea/textarea.js';

interface Props {
  name: string;
  id?: string;
  label: string;
  hint?: string;
  error?: string | undefined;
  /** The control: a wa-input (default) or a wa-textarea. */
  as?: 'input' | 'textarea';
  [key: string]: unknown;
}

const { name, id = name, label, hint, error, as = 'input', ...attrs } = Astro.props;
const Control = as === 'textarea' ? 'wa-textarea' : 'wa-input';
const errorId = `${id}-error`;
---
<Control id={id} name={name} label={label} aria-errormessage={errorId} with-hint {...attrs}>
  <div slot="hint" class="field-hint">
    {hint && <span class="field-hint-text">{hint}</span>}
    <span id={errorId} class="field-error">{error}</span>
  </div>
</Control>
