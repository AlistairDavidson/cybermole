---
// One app's settings, under the builder's portfolio framing: the icon
// picker (a wa-radio-group of button radios, one per registry name —
// previews are wa-icon over the vendored svgs), rename, and the cwd new workspaces start at; slug and
// timestamps read-only. `app` is null only when the slug resolves to no
// row (a 404 page body).
import '@awesome.me/webawesome/dist/components/card/card.js';
import '@awesome.me/webawesome/dist/components/button/button.js';
import '@awesome.me/webawesome/dist/components/icon/icon.js';
import '@awesome.me/webawesome/dist/components/callout/callout.js';
import '@awesome.me/webawesome/dist/components/radio-group/radio-group.js';
import '@awesome.me/webawesome/dist/components/radio/radio.js';
import '@awesome.me/webawesome/dist/components/tooltip/tooltip.js';
import '@awesome.me/webawesome/dist/components/format-date/format-date.js';
import WaField from '../form/WaField.astro';
import { zodSchemaToHTMLAttributes } from '../../lib/web/zod.service';
import { appSettingsForm } from '../../schemas/api';
import { APP_ICONS } from '../../lib/apps/app-icons';
import { BASE } from '../../base';
import type { ReadAppData } from '../../lib/apps/apps';

interface Props {
  app: ReadAppData | null;
}
const { app } = Astro.props;
const validation = zodSchemaToHTMLAttributes(appSettingsForm);
const iso = (at: number): string => new Date(at).toISOString();
/** wa-format-date's attributes for a full local date and time. */
const DATE_TIME = {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  hour: 'numeric',
  minute: '2-digit',
} as const;
---
{
  app ? (
    <main class="app-settings-main wa-stack wa-gap-m">
      <header class="settings-header app-settings-header">
        <h1 class="wa-cluster wa-gap-2xs wa-heading-l">
          <wa-icon id="app-settings-title-icon" name={app.icon} />
          <span id="app-settings-title-name">{app.name}</span>
        </h1>
        <p class="wa-caption-2xs">app settings — the icon, the name, and where its workspaces start</p>
      </header>

      <wa-card class="settings-card" with-header>
        <div slot="header" class="wa-split">
          <h2 class="card-title wa-heading-m">identity</h2>
          <span class="wa-caption-2xs">saved through the same service as rename</span>
        </div>
        <validation-enhancer-zod>
          <form id="app-settings-form" class="wa-stack wa-gap-s" novalidate>
            <wa-radio-group
              id="icon-pick"
              class="icon-grid"
              name="icon"
              label="icon"
              hint="the group header's glyph in the builder sidebar — the vendored set only"
              orientation="horizontal"
              value={app.icon}
            >
              {APP_ICONS.map(name => (
                <wa-radio id={`icon-pick-${name}`} appearance="button" value={name}>
                  <wa-icon name={name} label={name} />
                </wa-radio>
              ))}
            </wa-radio-group>
            {APP_ICONS.map(name => (
              <wa-tooltip for={`icon-pick-${name}`}>{name}</wa-tooltip>
            ))}
            <WaField
              id="app-name"
              name="name"
              label="name"
              hint="the display name; the slug is derived from it at creation and never changes"
              {...validation.name}
            />
            <WaField
              id="app-cwd"
              name="cwd"
              label="working directory"
              hint="where this app's workspaces start (created if missing); empty = the server default"
              {...validation.cwd}
            />
            <div class="wa-cluster wa-gap-2xs">
              <wa-button id="app-settings-save" type="button" variant="brand" size="s">
                <wa-icon slot="start" name="circle-check" />
                save
              </wa-button>
              <wa-button appearance="plain" size="s" href={`${BASE}/builder`}>
                back to the portfolio
              </wa-button>
            </div>
          </form>
        </validation-enhancer-zod>
        <wa-callout id="app-settings-result" class="hidden" />
      </wa-card>

      <wa-card class="settings-card" with-header>
        <div slot="header" class="wa-split">
          <h2 class="card-title wa-heading-m">read-only</h2>
          <span class="wa-caption-2xs">the slug is the app's address; the timestamps are its row's</span>
        </div>
        <div class="wa-stack wa-gap-2xs">
          <div class="cfg-row wa-split">
            <span class="k wa-color-text-quiet">slug</span>
            <span class="v">
              <code>{app.slug}</code>
            </span>
          </div>
          <div class="cfg-row wa-split">
            <span class="k wa-color-text-quiet">created</span>
            <wa-format-date class="v" date={iso(app.createdAt)} {...DATE_TIME} />
          </div>
          <div class="cfg-row wa-split">
            <span class="k wa-color-text-quiet">updated</span>
            <wa-format-date class="v" date={iso(app.updatedAt)} {...DATE_TIME} />
          </div>
        </div>
      </wa-card>

      {/* The client half's source of truth: wa-input's value is a property
          the server can't render, so the fields prefill from here. */}
      <span
        id="app-settings-prefill"
        hidden
        data-slug={app.slug}
        data-name={app.name}
        data-cwd={app.cwd ?? ''}
        data-icon={app.icon}
      />
    </main>
  ) : (
    <main class="app-settings-main wa-stack wa-gap-s">
      <header class="settings-header app-settings-header">
        <h1 class="wa-heading-l">no such app</h1>
      </header>
      <wa-callout variant="warning">
        <wa-icon slot="icon" name="triangle-exclamation" />
        no app answers this slug — it may have been deleted or never registered.
      </wa-callout>
      <wa-button appearance="plain" size="s" href={`${BASE}/builder`}>
        back to the portfolio
      </wa-button>
    </main>
  )
}
