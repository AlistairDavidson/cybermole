---
// One job card. The buttons carry their data attributes for <jobs-app>'s
// delegated clicks, so a refreshed list needs no rewiring.
import '@awesome.me/webawesome/dist/components/button/button.js';
import '@awesome.me/webawesome/dist/components/icon/icon.js';
import '@awesome.me/webawesome/dist/components/card/card.js';
import '@awesome.me/webawesome/dist/components/badge/badge.js';
import type { ScheduledJob } from '../../lib/platform/types';

interface Props {
  job: ScheduledJob;
}
const { job } = Astro.props;

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/+$/, '');
const last = job.last
  ? `${job.last}${job.lastResult === 'success' ? ' · ok' : job.lastResult === 'failed' ? ' · failed' : ''}`
  : 'never';
---
<wa-card class="job" with-header with-footer>
  <div slot="header" class="wa-split wa-gap-s">
    <h2 class="job-title wa-heading-s">
      <a class="job-name wa-cluster wa-gap-2xs" href={`${base}/jobs/${encodeURIComponent(job.name)}`}>
        <wa-icon name="clock"></wa-icon>{job.name}
      </a>
    </h2>
    <span class="wa-cluster wa-gap-3xs">
      {job.appName && <wa-badge pill class="job-app">{job.appName}</wa-badge>}
      {job.active
        ? <wa-badge pill variant="success">scheduled</wa-badge>
        : <wa-badge pill>invalid schedule</wa-badge>}
      {job.running && <wa-badge pill variant="brand">running</wa-badge>}
      {job.lastResult === 'failed' && <wa-badge pill variant="danger">last run failed</wa-badge>}
      {job.running && (
        <wa-button
          class="job-view"
          appearance="plain"
          size="s"
          href={`${base}/?run=${encodeURIComponent(job.session)}`}
        >
          view run<wa-icon slot="end" name="play"></wa-icon>
        </wa-button>
      )}
    </span>
  </div>
  <dl class="job-meta wa-stack wa-gap-2xs">
    <div class="cfg-row wa-split"><dt class="wa-color-text-quiet">schedule</dt><dd class="v"><code>{job.schedule || '—'}</code></dd></div>
    <div class="cfg-row wa-split"><dt class="wa-color-text-quiet">command</dt><dd class="v"><code>{job.command || '—'}</code></dd></div>
    <div class="cfg-row wa-split"><dt class="wa-color-text-quiet">next</dt><dd class="v">{job.next ?? '—'}</dd></div>
    <div class="cfg-row wa-split"><dt class="wa-color-text-quiet">last run</dt><dd class="v">{last}</dd></div>
  </dl>
  <div slot="footer" class="wa-cluster wa-gap-2xs">
    <wa-button size="s" data-run={job.name}>
      <wa-icon slot="start" name="play"></wa-icon>run now
    </wa-button>
    <wa-button size="s" appearance="plain" data-runs={job.name}>
      <wa-icon slot="start" name="eye"></wa-icon>runs
    </wa-button>
    <wa-button size="s" appearance="plain" data-edit={job.name}
      data-schedule={job.schedule} data-command={job.command} data-app={job.appId ?? ''}>
      <wa-icon slot="start" name="pencil"></wa-icon>edit
    </wa-button>
    <wa-button size="s" appearance="plain" variant="danger" data-del={job.name}>
      <wa-icon slot="start" name="trash-can"></wa-icon>delete
    </wa-button>
  </div>
</wa-card>
