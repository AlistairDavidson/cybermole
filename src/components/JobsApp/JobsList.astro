---
// The jobs list, rendered by the /jobs page and the partial. `jobs` is null
// only for a failed listing. `apps` rides along as data-apps on the root, so
// the tag picker renews with each refresh without a second fetch.
import JobCard from './JobCard.astro';
import type { AppState } from '../../lib/platform/types';
import type { ScheduledJob } from '../../lib/platform/types';

interface Props {
  jobs: ScheduledJob[] | null;
  apps: AppState[];
}
const { jobs, apps } = Astro.props;
---
<div id="jobs-list" class="wa-stack wa-gap-s" data-apps={JSON.stringify(apps)}>
  {jobs === null
    ? <p class="jobs-empty">the list could not be read — the refresh keeps trying</p>
    : jobs.length === 0
      ? <p class="jobs-empty">no jobs yet — "new job" schedules a recurring command.</p>
      : jobs.map(job => <JobCard job={job} />)}
</div>
