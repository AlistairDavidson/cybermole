---
import "@awesome.me/webawesome/dist/components/button/button.js";
import "@awesome.me/webawesome/dist/components/icon/icon.js";
import "@awesome.me/webawesome/dist/components/card/card.js";
import "@awesome.me/webawesome/dist/components/badge/badge.js";
import "@awesome.me/webawesome/dist/components/dialog/dialog.js";
import "@awesome.me/webawesome/dist/components/input/input.js";
import "@awesome.me/webawesome/dist/components/select/select.js";
import "@awesome.me/webawesome/dist/components/option/option.js";
import "@awesome.me/webawesome/dist/components/textarea/textarea.js";
import "@awesome.me/webawesome/dist/components/toast/toast.js";
import JobsList from "./JobsList.astro";
import RunHistory from "../RunHistory/RunHistory.astro";
import WaField from "../form/WaField.astro";
import { zodSchemaToHTMLAttributes } from "../../lib/web/zod.service";
import { JobSaveSchema } from "../../schemas/jobs";
import type { AppState } from "../../lib/platform/types";
import type { ScheduledJob } from "../../lib/platform/types";

interface Props {
  /** null when the read failed (the poll retries) */
  jobs: ScheduledJob[] | null;
  /** the tag picker's options */
  apps: AppState[];
}
const { jobs, apps } = Astro.props;

// Native constraints from the same schema the dialog and POST /api/jobs use.
const validation = zodSchemaToHTMLAttributes(JobSaveSchema);
---

<jobs-app>
  <main class="jobs-main wa-stack wa-gap-m">
    <header class="jobs-header wa-split">
      <h1>
        <wa-icon name="clock"></wa-icon> scheduled jobs
      </h1>
      <div class="wa-cluster wa-gap-2xs">
        <wa-button id="jobs-new" variant="brand" size="s">
          <wa-icon slot="start" name="plus"></wa-icon>new job
        </wa-button>
      </div>
    </header>
    <p class="wa-caption-s">
      A job is a name, a 5-field <code>cron</code> schedule and a shell
      command, run by cybermole's built-in scheduler inside a tmux session on
      the app's socket — every run shows up in the console's
      <strong>Live</strong> list and is attachable, just like a session you
      started yourself.
    </p>
    <JobsList jobs={jobs} apps={apps} />
  </main>

  <wa-dialog id="job-dialog" label="new job" with-footer>
    <validation-enhancer-zod>
      <form id="job-form" class="wa-stack wa-gap-s" novalidate>
        <WaField
          id="job-name"
          name="name"
          label="name"
          placeholder="nightly-check"
          hint="runs open in tmux session cybermole-<name>"
          {...validation.name}
        />
        <div>
          <WaField
            id="job-schedule"
            name="schedule"
            label="schedule (cron)"
            placeholder="*/5 * * * *"
            hint="*/5 * * * * · 0 8 * * * · 30 9 * * 1-5"
            {...validation.schedule}
          />
          <div
            id="schedule-feedback"
            class="schedule-feedback"
            aria-live="polite"
          ></div>
        </div>
        <WaField
          as="textarea"
          id="job-command"
          name="command"
          label="command (shell; runs in tmux session cybermole-<name>)"
          placeholder={'pi -p "summarize today\'s commits"'}
          rows="3"
          {...validation.command}
        />
        <!-- Not a named form field: the enhancer validates against
             JobSaveSchema, where an empty optional select would trip the
             uuid pattern. Options are cloned from the list's template on open. -->
        <wa-select
          id="job-app"
          label="app tag (optional — grouping only)"
          placeholder="no app — global job"
          with-clear
        ></wa-select>
      </form>
    </validation-enhancer-zod>
    <wa-button slot="footer" appearance="plain" data-dialog="close">
      cancel
    </wa-button>
    <wa-button slot="footer" id="job-save" variant="brand">
      save
    </wa-button>
  </wa-dialog>

  <wa-dialog id="job-delete-dialog" label="delete job" with-footer>
    <p id="job-delete-text"></p>
    <wa-button slot="footer" appearance="plain" data-dialog="close">
      cancel
    </wa-button>
    <wa-button slot="footer" id="job-delete-confirm" variant="danger">
      delete
    </wa-button>
  </wa-dialog>

  <!-- A dialog rather than an inline expansion: the list is swapped by the
       15 s poll, which would wipe an open history. -->
  <wa-dialog id="runs-dialog" label="run history" class="runs-dialog">
    <div class="wa-stack wa-gap-s">
      <RunHistory emptyHint={'"run now" fires one.'} />
      <div id="run-log-box" class="run-log-box hidden">
        <div class="run-log-head">
          <span id="run-log-title"></span>
          <wa-button size="xs" appearance="plain" id="run-log-close">hide log</wa-button>
        </div>
        <pre id="run-log" class="run-log"></pre>
      </div>
    </div>
    <wa-button slot="footer" appearance="plain" data-dialog="close">
      close
    </wa-button>
  </wa-dialog>

  <wa-toast placement="bottom-start"></wa-toast>
</jobs-app>

<script>
  import "@awesome.me/astro-lit/dsd-polyfill.js";
  import "@awesome.me/astro-lit/hydration-support.js";
  import "../../icons";
  import "./jobs-app";
</script>
