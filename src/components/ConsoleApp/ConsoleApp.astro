---
// The console shell, on both pages: scope "console" (the orchestration
// page — console workspaces, jobs, settings) or "builder" (the app
// portfolio — app workspace groups, lifecycle chips, + app). Rendered into
// Base.astro's wa-page, filling its navigation slots and its main area.
// The dialogs live in <console-app>, outside the sidebar's restamped
// groups, so their state survives it. The wa-* imports here only SSR;
// console-app.ts re-imports them client-side (AGENTS.md).
import '@awesome.me/webawesome/dist/components/tooltip/tooltip.js';
import '@awesome.me/webawesome/dist/components/button/button.js';
import '@awesome.me/webawesome/dist/components/dialog/dialog.js';
import '@awesome.me/webawesome/dist/components/icon/icon.js';
import '@awesome.me/webawesome/dist/components/toast/toast.js';
import WaField from '../form/WaField.astro';
import TerminalTabs from '../TerminalTabs/TerminalTabs.astro';
import WorkspaceSidebar from '../WorkspaceSidebar/WorkspaceSidebar.astro';
import { zodSchemaToHTMLAttributes } from '../../lib/web/zod.service';
import { appForm, buildSessionForm, consoleWorkspaceForm } from '../../schemas/api';

interface Props {
  scope?: 'console' | 'builder';
}
const { scope = 'console' } = Astro.props;

// Native constraints from the dialogs' schemas; the server re-validates anyway.
const appValidation = zodSchemaToHTMLAttributes(appForm);
// The console dialog self-names (both fields optional); a build session
// has no cwd to name from, so the builder dialog keeps the name required.
const consoleWsValidation = zodSchemaToHTMLAttributes(consoleWorkspaceForm);
const buildValidation = zodSchemaToHTMLAttributes(buildSessionForm);
const wsValidation = scope === 'builder' ? buildValidation : consoleWsValidation;
---
<!-- Three wa-page slots (Base.astro's shell): the drawer column's header
     (the desktop collapse control) and the sidebar, then the main area,
     whose <console-app> controls all three — the sidebar's events reach it
     through the document. -->
<div slot="navigation-header" class="nav-header">
  <wa-button
    id="nav-collapse"
    class="nav-collapse"
    appearance="plain"
    size="s"
    aria-label="collapse the sidebar"
    aria-expanded="true"
  >
    <wa-icon slot="start" name="chevron-left" class="when-open" label="collapse the sidebar"></wa-icon>
    <wa-icon slot="start" name="chevron-right" class="when-collapsed" label="expand the sidebar"></wa-icon>
  </wa-button>
  <wa-tooltip for="nav-collapse" placement="right">collapse / expand the sidebar</wa-tooltip>
</div>
<WorkspaceSidebar scope={scope} />
<console-app scope={scope}>
  <main class="console-main"><TerminalTabs /></main>
  <wa-toast placement="bottom-start"></wa-toast>

  <wa-dialog id="app-dialog" label="New app" with-footer>
    <validation-enhancer-zod>
      <form id="app-form" class="wa-stack wa-gap-s">
        <WaField
          id="app-name"
          name="name"
          label="name"
          hint="the slug is derived (lowercase, dashes) and stays fixed"
          {...appValidation.name}
        />
        <WaField
          id="app-cwd"
          name="cwd"
          label="working directory"
          hint="workspaces under this app start here (created if missing); auto-filled from the name until you edit it — empty starts them at the server default"
          {...appValidation.cwd}
        />
        <p class="wa-caption-s" id="app-icon-preview">
          <wa-icon id="app-icon-glyph" name="cubes"></wa-icon>
          <span id="app-icon-name">suggested icon: cubes (from the name)</span>
        </p>
      </form>
    </validation-enhancer-zod>
    <wa-button slot="footer" appearance="plain" data-dialog="close">cancel</wa-button>
    <wa-button slot="footer" id="app-save" variant="brand">create</wa-button>
  </wa-dialog>

  <wa-dialog id="workspace-dialog" label="New workspace" with-footer>
    <validation-enhancer-zod>
      <form id="workspace-form" class="wa-stack wa-gap-s">
        {
          scope === 'console' && (
            <WaField
              id="workspace-cwd"
              name="cwd"
              label="working directory"
              hint="an existing folder this workspace's terminals start in; empty starts at the server default"
              {...consoleWsValidation.cwd}
            />
          )
        }
        <WaField
          id="workspace-name"
          name="name"
          label="name"
          hint={
            scope === 'console'
              ? 'auto-filled from the directory until you edit it — empty names it after the directory'
              : undefined
          }
          {...wsValidation.name}
        />
        <p class="wa-caption-s" id="workspace-start">starts at the server default</p>
      </form>
    </validation-enhancer-zod>
    <wa-button slot="footer" appearance="plain" data-dialog="close">cancel</wa-button>
    <wa-button slot="footer" id="workspace-save" variant="brand">create</wa-button>
  </wa-dialog>

  <wa-dialog id="confirm-delete" label="Delete" with-footer>
    <p class="dialog-text" id="confirm-delete-text"></p>
    <p class="wa-caption-s" id="confirm-delete-note"></p>
    <wa-button slot="footer" appearance="plain" data-dialog="close">cancel</wa-button>
    <wa-button slot="footer" id="confirm-delete-ok" variant="danger">delete</wa-button>
  </wa-dialog>
</console-app>

<script>
  // Must precede any wa-* import, or SSR'd elements render twice.
  import '@awesome.me/astro-lit/dsd-polyfill.js';
  import '@awesome.me/astro-lit/hydration-support.js';
  import '../../icons';
  import './console-app.ts';
</script>
