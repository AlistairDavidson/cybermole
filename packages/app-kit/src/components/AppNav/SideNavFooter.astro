---
// Settings and sign-out, wa-page's navigation-footer under SideNav;
// side-nav.ts wires sign-out.
import '@awesome.me/webawesome/dist/components/button/button.js';
import '@awesome.me/webawesome/dist/components/icon/icon.js';
import type { Section } from './nav';

interface Props {
  base: string;
  current: Section | null;
}
const { base, current } = Astro.props;
---
<div slot="navigation-footer" class="side-nav-footer wa-stack wa-gap-0 wa-align-items-start">
  <wa-button
    id="nav-settings"
    appearance="plain"
    size="s"
    href={`${base}/settings`}
    {...(current === 'settings' ? { 'aria-current': 'page', variant: 'brand' } : {})}
  >
    <wa-icon slot="start" name="gear"></wa-icon>
    Settings
  </wa-button>
  <wa-button id="sign-out" appearance="plain" size="s" data-sign-out>
    <wa-icon slot="start" name="right-from-bracket"></wa-icon>
    Sign out
  </wa-button>
</div>
