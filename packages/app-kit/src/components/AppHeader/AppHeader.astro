---
// The cybermole header bar, one component for the console's pages and every
// app's (AppShell): wa-page's header slot. Section links are wa-buttons with
// href, so they're real anchors that work without JS; app-header.ts wires
// the drawer toggle, the Apps menu and the account menu (settings,
// sign-out). The wa-* imports here only SSR; the page's client script
// imports app-header.ts, which re-imports them.
import '@awesome.me/webawesome/dist/components/breadcrumb/breadcrumb.js';
import '@awesome.me/webawesome/dist/components/breadcrumb-item/breadcrumb-item.js';
import '@awesome.me/webawesome/dist/components/button/button.js';
import '@awesome.me/webawesome/dist/components/divider/divider.js';
import '@awesome.me/webawesome/dist/components/dropdown/dropdown.js';
import '@awesome.me/webawesome/dist/components/dropdown-item/dropdown-item.js';
import '@awesome.me/webawesome/dist/components/icon/icon.js';
import '@awesome.me/webawesome/dist/components/tooltip/tooltip.js';
import NavLink from './NavLink.astro';
import type { MenuItem, Section } from './nav';

interface Props {
  /** The console's base path, '' at the site root. */
  base: string;
  /** The section marked current; null for none. */
  current: Section | null;
  /** CYBERMOLE_GRAFANA_URL is set. Omitted (an app page can't know):
   *  rendered hidden, and the Apps menu's state read reveals it. */
  logs?: boolean;
  /** The page has a wa-page navigation column for the toggle to open. */
  drawer?: boolean;
  /** The sections live in the navigation column (SideNav): the bar keeps
   *  the toggle and brand, and shows where you are as a breadcrumb. */
  sideNav?: boolean;
}

const { base, current, logs, drawer = true, sideNav = false } = Astro.props;
const sectionHref: Record<Section, string> = {
  console: `${base}/`, apps: `${base}/apps`, builder: `${base}/builder`, jobs: `${base}/jobs`, logs: `${base}/logs`, settings: `${base}/settings`,
};
const sectionLabel: Record<Section, string> = {
  console: 'Console', apps: 'Apps', builder: 'Builder', jobs: 'Jobs', logs: 'Logs', settings: 'Settings',
};

const left: MenuItem[] = [
  { section: 'console', label: 'Cybermole', href: `${base}/`, icon: 'cybermole', className: 'app-nav-link app-brand' },
  { section: 'builder', label: 'Builder', href: `${base}/builder`, icon: 'cubes' },
  { section: 'jobs', label: 'Jobs', href: `${base}/jobs`, icon: 'clock' },
];
const logsLink: MenuItem = { section: 'logs', label: 'Logs', href: `${base}/logs`, icon: 'file-lines' };
const accountCurrent = current === 'settings' ? { 'aria-current': 'page', variant: 'brand' } : {};
const appsCurrent = current === 'apps' ? { 'aria-current': 'page', variant: 'brand' } : {};
---
<app-header slot="header" class="wa-split wa-gap-s" data-base={base} {...(logs === undefined ? { 'data-logs-auto': '' } : {})}>
  <nav class="wa-cluster wa-gap-2xs">
    <!-- The mobile drawer toggle, far left where the thumb lives. wa-page
         wires any data-toggle-nav button in its light DOM; its base styles
         hide it on desktop. app-header.ts mirrors nav-open onto its
         semantics. -->
    {drawer && (
      <wa-button
        id="nav-drawer-toggle"
        class="nav-drawer-toggle"
        data-toggle-nav
        appearance="plain"
        size="s"
        aria-label="open navigation"
        aria-expanded="false"
      >
        <wa-icon name="bars" label="open navigation"></wa-icon>
      </wa-button>
    )}
    {sideNav ? (
      <>
        <NavLink item={{ ...left[0]!, id: 'nav-brand' }} current={null} />
        <!-- The page fills the data-crumb items it knows (the selected
             app and workspace); an empty one stays hidden. -->
        <wa-breadcrumb class="where" label="location">
          <wa-breadcrumb-item href={current ? sectionHref[current] : undefined}>{current ? sectionLabel[current] : ''}</wa-breadcrumb-item>
          <wa-breadcrumb-item data-crumb="app" hidden></wa-breadcrumb-item>
          <wa-breadcrumb-item data-crumb="workspace" hidden></wa-breadcrumb-item>
        </wa-breadcrumb>
      </>
    ) : (
      <>
        <NavLink item={left[0]!} current={current} />
        <wa-tooltip for="nav-apps">Apps</wa-tooltip>
        {left.slice(1).map(l => <NavLink item={l} current={current} />)}
        {logs !== false && <NavLink item={logsLink} current={current} hidden={logs === undefined} />}
      </>
    )}
  </nav>


  {!sideNav && (<>
  <!-- The Apps menu: its items are stamped from the template by
       app-header.ts off GET /api/state, on connect and on every open. -->
  <wa-dropdown class="apps-menu">
    <wa-button slot="trigger" id="nav-apps" appearance="plain" size="s" {...appsCurrent}>
      <wa-icon slot="start" name="table-cells-large" label="Apps"></wa-icon>
    </wa-button>
    <wa-dropdown-item class="apps-status" disabled>loading apps…</wa-dropdown-item>
    <wa-divider></wa-divider>
    <wa-dropdown-item class="apps-all" data-href={`${base}/apps`}>
      <wa-icon slot="icon" name="list"></wa-icon>
      All apps
    </wa-dropdown-item>
    <template data-app-item>
      <wa-dropdown-item class="app-item">
        <wa-icon slot="icon"></wa-icon>
        <span class="app-name"></span>
        <span slot="details" class="app-off">not serving</span>
      </wa-dropdown-item>
    </template>
  </wa-dropdown>
  <!-- Settings and sign-out share one menu, so the bar fits one row on
       a phone. -->
  <wa-dropdown class="account-menu" placement="bottom-end">
    <wa-button slot="trigger" id="nav-account" appearance="plain" size="s" {...accountCurrent}>
      <wa-icon slot="start" name="circle-user" label="Account"></wa-icon>
    </wa-button>
    <wa-dropdown-item id="nav-settings" data-href={`${base}/settings`}>
      <wa-icon slot="icon" name="gear"></wa-icon>
      Settings
    </wa-dropdown-item>
    <wa-dropdown-item id="sign-out" value="sign-out">
      <wa-icon slot="icon" name="right-from-bracket"></wa-icon>
      Sign out
    </wa-dropdown-item>
  </wa-dropdown>
  <wa-tooltip for="nav-account">Account</wa-tooltip>
  </>)}
</app-header>
