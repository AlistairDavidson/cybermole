{
  "name": "@cybermole/app-kit",
  "version": "0.1.0",
  "description": "The shared half of cybermole — what apps (and the console) are built on: the Result family + branded IDs, the node-free zod schema layer, the Result→HTTP mapping, the node:sqlite helper, the object-storage client, the route-table binder, and the per-app e2e harness. Ships SOURCE, no build step: astro/vite compiles it through the workspace symlink, the console's server tsc compiles it in place.",
  "license": "MIT",
  "sideEffects": [
    "./src/wa-client.ts",
    "./src/agent-console.ts",
    "./src/components/AppNav/app-nav.ts",
    "./src/components/AppNav/side-nav.ts",
    "./src/components/AppNav/nav-toggle.ts",
    "./src/components/AppNav/page-router.ts",
    "./src/components/**/*.css",
    "./src/components/AppShell/app-shell.ts",
    "./src/components/**/*.astro"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./route-table": "./src/route-table.ts",
    "./route-table-emit": "./src/route-table-emit.ts",
    "./wa-client": "./src/wa-client.ts",
    "./element": "./src/element.ts",
    "./live": "./src/live.ts",
    "./agent-console": "./src/agent-console.ts",
    "./icons": "./src/icons.ts",
    "./app-menu": "./src/app-menu.ts",
    "./AppShell.astro": "./src/components/AppShell/AppShell.astro",
    "./AppPage.astro": "./src/components/AppNav/AppPage.astro",
    "./NavToggle.astro": "./src/components/AppNav/NavToggle.astro",
    "./PageRouter.astro": "./src/components/AppNav/PageRouter.astro",
    "./app-nav": "./src/components/AppNav/app-nav.ts",
    "./app-shell": "./src/components/AppShell/app-shell.ts",
    "./testing": "./src/testing/index.mts"
  },
  "dependencies": {
    "@awesome.me/astro-lit": "^5.0.4",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/lib-storage": "^3.1149.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@preact/signals-core": "^1.14.5",
    "kysely": "^0.29.6",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "@playwright/test": "^1.59.0"
  }
}
